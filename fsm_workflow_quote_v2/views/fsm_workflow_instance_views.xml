<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <!-- List View -->
  <record id="view_fsm_workflow_instance_list" model="ir.ui.view">
    <field name="name">fsm.workflow.instance.list</field>
    <field name="model">fsm.workflow.instance</field>
    <field name="arch" type="xml">
      <list string="FSM Workflow Instances">
        <field name="name"/>
        <field name="partner_id"/>
        <field name="template_id"/>
        <field name="state"/>
        <field name="quotation_state"/>
        <field name="quotation_amount"/>
        <field name="checkpoint_progress" widget="percentage"/>
        <field name="timesheet_hours"/>
        <field name="create_date"/>
      </list>
    </field>
  </record>

  <!-- Form View -->
  <record id="view_fsm_workflow_instance_form" model="ir.ui.view">
    <field name="name">fsm.workflow.instance.form</field>
    <field name="model">fsm.workflow.instance</field>
    <field name="arch" type="xml">
      <form string="FSM Workflow Instance">
        <header>
          <field name="quotation_state" widget="statusbar" statusbar_visible="draft,sent,sale"/>
        </header>
        <sheet>
          <div class="oe_title">
            <h1>
              <field name="name" readonly="1"/>
            </h1>
          </div>
          
          <div class="oe_button_box" name="button_box">
            <button name="action_open_project" type="object" class="oe_stat_button" icon="fa-tasks" string="Open Project">
              <field name="project_id" invisible="1"/>
            </button>
            <button name="action_open_fsm" type="object" class="oe_stat_button" icon="fa-truck" string="Open FSM">
              <field name="fsm_order_id" invisible="1"/>
            </button>
            <button name="action_open_sale" type="object" class="oe_stat_button" icon="fa-file-text-o" string="Open Quotation">
              <field name="sale_order_id" invisible="1"/>
            </button>
            <button name="action_open_checkpoints" type="object" class="oe_stat_button" icon="fa-check-square-o" string="Checkpoints">
              <field name="project_id" invisible="1"/>
            </button>
            <button name="action_create_checkpoint" type="object" class="oe_stat_button" icon="fa-plus" string="Add Checkpoint">
              <field name="project_id" invisible="1"/>
            </button>
            <button name="action_create_handover" type="object" class="oe_stat_button" icon="fa-exchange" string="Create Handover">
              <field name="project_id" invisible="1"/>
              <field name="partner_id" invisible="1"/>
            </button>
            <button name="action_create_quotation" type="object" class="oe_stat_button" icon="fa-file-text-o" string="Create Quotation" 
                    invisible="sale_order_id != False">
              <field name="partner_id" invisible="1"/>
            </button>
            <button name="action_send_quotation" type="object" class="oe_stat_button" icon="fa-paper-plane" string="Send Quotation"
                    invisible="quotation_state not in ['draft']">
              <field name="sale_order_id" invisible="1"/>
            </button>
            <button name="action_confirm_quotation" type="object" class="oe_stat_button" icon="fa-check" string="Confirm Quotation"
                    invisible="quotation_state not in ['draft', 'sent']">
              <field name="sale_order_id" invisible="1"/>
            </button>
          </div>
          
          <widget name="web_ribbon" title="Archived" bg_color="text-bg-warning" invisible="active"/>
          <field name="state" widget="statusbar" statusbar_visible="draft,in_progress,completed"/>
          
          <group>
            <group>
              <field name="partner_id"/>
              <field name="template_id"/>
              <field name="project_id"/>
              <field name="fsm_order_id"/>
            </group>
            <group>
              <field name="timesheet_hours"/>
              <field name="total_checkpoints"/>
              <field name="completed_checkpoints"/>
              <field name="checkpoint_progress" widget="percentage"/>
            </group>
          </group>
          
          <!-- Quotation Section -->
          <group string="Quotation Details" name="quotation_section">
            <group>
              <field name="pricing_policy"/>
              <field name="estimated_hours"/>
              <field name="hourly_rate" invisible="pricing_policy != 'hourly'"/>
              <field name="fixed_price" invisible="pricing_policy != 'fixed'"/>
            </group>
            <group>
              <field name="sale_order_id" readonly="1"/>
              <field name="quotation_amount" readonly="1"/>
              <field name="currency_id" invisible="1"/>
            </group>
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <!-- Search View -->
  <record id="view_fsm_workflow_instance_search" model="ir.ui.view">
    <field name="name">fsm.workflow.instance.search</field>
    <field name="model">fsm.workflow.instance</field>
    <field name="arch" type="xml">
      <search string="Search FSM Workflow Instances">
        <field name="name"/>
        <field name="partner_id"/>
        <field name="template_id"/>
        <field name="project_id"/>
        <separator/>
        <filter string="Draft Quotations" name="draft_quotations" domain="[('quotation_state', '=', 'draft')]"/>
        <filter string="Sent Quotations" name="sent_quotations" domain="[('quotation_state', '=', 'sent')]"/>
        <filter string="Confirmed Orders" name="confirmed_orders" domain="[('quotation_state', '=', 'sale')]"/>
        <separator/>
        <filter string="Fixed Price" name="fixed_price" domain="[('pricing_policy', '=', 'fixed')]"/>
        <filter string="Time &amp; Material" name="time_material" domain="[('pricing_policy', '=', 'time_material')]"/>
        <filter string="Hourly Rate" name="hourly_rate" domain="[('pricing_policy', '=', 'hourly')]"/>
        <group expand="0" string="Group By">
          <filter string="Customer" name="group_partner" context="{'group_by': 'partner_id'}"/>
          <filter string="Template" name="group_template" context="{'group_by': 'template_id'}"/>
          <filter string="Quotation Status" name="group_quotation_state" context="{'group_by': 'quotation_state'}"/>
          <filter string="Pricing Policy" name="group_pricing_policy" context="{'group_by': 'pricing_policy'}"/>
          <filter string="Creation Date" name="group_create_date" context="{'group_by': 'create_date:day'}"/>
        </group>
      </search>
    </field>
  </record>

  <!-- Action -->
  <record id="action_fsm_workflow_instance" model="ir.actions.act_window">
    <field name="name">FSM Workflow Instances</field>
    <field name="res_model">fsm.workflow.instance</field>
    <field name="view_mode">list,form</field>
    <field name="context">{}</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">
        Create your first FSM Workflow Instance!
      </p>
      <p>
        FSM Workflow Instances help you manage field service workflows from template to quotation.
      </p>
    </field>
  </record>

  <!-- Menu Items -->
  <menuitem id="menu_fsm_workflow_root"
            name="FSM Workflow"
            sequence="10"/>

  <menuitem id="menu_fsm_workflow_instance"
            name="Workflow Instances"
            parent="menu_fsm_workflow_root"
            action="action_fsm_workflow_instance"
            sequence="10"/>


</odoo>
