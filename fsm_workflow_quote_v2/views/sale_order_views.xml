<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <!-- Sale Order Form View Extension -->
  <record id="view_sale_order_form_workflow" model="ir.ui.view">
    <field name="name">sale.order.form.workflow</field>
    <field name="model">sale.order</field>
    <field name="inherit_id" ref="sale.view_order_form"/>
    <field name="arch" type="xml">
      <xpath expr="//sheet/group" position="after">
        <group string="Workflow Integration" invisible="not is_workflow_quotation">
          <field name="workflow_instance_id" readonly="1"/>
          <field name="is_workflow_quotation" invisible="1"/>
          <field name="workflow_trigger_type"/>
          <field name="workflow_trigger_name" readonly="1"/>
        </group>
      </xpath>
      <xpath expr="//div[@name='button_box']" position="inside">
        <button name="action_open_workflow_instance" type="object" class="oe_stat_button" icon="fa-tasks" string="Workflow Instance" invisible="not workflow_instance_id">
          <field name="workflow_instance_id" invisible="1"/>
        </button>
      </xpath>
    </field>
  </record>

