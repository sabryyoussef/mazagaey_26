<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Form View -->
        <record id="view_project_task_checkpoint_form" model="ir.ui.view">
            <field name="name">project.task.checkpoint.form</field>
            <field name="model">project.task.checkpoint</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <group>
                                <field name="name"/>
                                <field name="sequence"/>
                                <field name="task_id"/>
                                <field name="milestone_id"/>
                                <field name="compliance_project_id"/>
                            </group>
                            <group>
                                <field name="is_reached"/>
                                <field name="auto_advance_stage"/>
                                <field name="target_stage_id" invisible="not auto_advance_stage"/>
                            </group>
                        </group>
                        
                        <!-- Enhanced Checkpoint Management -->
                        <notebook>
                            <page string="Visibility &amp; Dependencies" name="visibility_dependencies">
                                <group>
                                    <group string="Visibility Conditions">
                                        <field name="is_visible" readonly="1"/>
                                        <field name="visibility_condition" placeholder="e.g., task_id.stage_id.name == 'Development'"/>
                                        <field name="visibility_depends_on" widget="many2many_tags"/>
                                    </group>
                                    <group string="Dependencies">
                                        <field name="can_start" readonly="1"/>
                                        <field name="dependency_type"/>
                                        <field name="prerequisite_ids" widget="many2many_tags"/>
                                    </group>
                                </group>
                            </page>
                            
                            <page string="Checklist Items" name="checklist_items">
                                <div class="oe_button_box" name="checklist_button_box">
                                    <div class="oe_stat_button" icon="fa-check-square-o">
                                        <div class="o_field_widget o_stat_info">
                                            <span class="o_stat_value">
                                                <field name="checklist_completed_count"/>/<field name="checklist_total_count"/>
                                            </span>
                                            <span class="o_stat_text">Checklist Items</span>
                                        </div>
                                    </div>
                                </div>
                                
                                <field name="checklist_item_ids" mode="list" context="{'default_checkpoint_id': id}">
                                    <list string="Checklist Items" editable="bottom">
                                        <field name="sequence" widget="handle"/>
                                        <field name="name"/>
                                        <field name="is_required"/>
                                        <field name="is_completed" widget="boolean_toggle"/>
                                        <field name="completed_by"/>
                                        <button name="action_toggle_completion" type="object" 
                                                string="Toggle" class="btn-link"/>
                                    </list>
                                </field>
                            </page>
                            
                            <page string="Tags &amp; Notes" name="tags_notes">
                                <group>
                                    <field name="tag_ids" widget="many2many_tags"/>
                                    <field name="notes"/>
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- List View -->
        <record id="view_project_task_checkpoint_list" model="ir.ui.view">
            <field name="name">project.task.checkpoint.list</field>
            <field name="model">project.task.checkpoint</field>
            <field name="arch" type="xml">
                <list>
                    <field name="sequence"/>
                    <field name="name"/>
                    <field name="task_id"/>
                    <field name="milestone_id"/>
                    <field name="compliance_project_id"/>
                    <field name="is_visible"/>
                    <field name="is_reached"/>
                    <field name="can_start"/>
                    <field name="target_stage_id"/>
                </list>
            </field>
        </record>

        <!-- Action -->
        <record id="action_project_task_checkpoint" model="ir.actions.act_window">
            <field name="name">Task Checkpoints</field>
            <field name="res_model">project.task.checkpoint</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create your first task checkpoint!
                </p>
                <p>
                    Task checkpoints help you track progress and milestones within tasks.
                </p>
            </field>
        </record>

        <!-- Checkpoint Checklist Item Action -->
        <record id="action_project_checkpoint_checklist_item" model="ir.actions.act_window">
            <field name="name">Checkpoint Checklist Items</field>
            <field name="res_model">project.checkpoint.checklist.item</field>
            <field name="view_mode">list,form,kanban</field>
            <field name="domain">[('checkpoint_id', '=', active_id)]</field>
            <field name="context">{'default_checkpoint_id': active_id}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create your first checklist item for this checkpoint!
                </p>
                <p>
                    Checklist items help you track detailed tasks within each checkpoint.
                </p>
            </field>
        </record>
    </data>
</odoo>
