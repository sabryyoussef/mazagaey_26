<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Checkpoint Checklist Item Views -->
    
    <!-- Checkpoint Checklist Item List View -->
    <record id="view_checkpoint_checklist_item_list" model="ir.ui.view">
        <field name="name">checkpoint.checklist.item.list</field>
        <field name="model">project.checkpoint.checklist.item</field>
        <field name="arch" type="xml">
            <list string="Checkpoint Checklist Items">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="checkpoint_id"/>
                <field name="is_required"/>
                <field name="is_completed" widget="boolean_toggle"/>
                <field name="completed_by"/>
                <field name="completed_date"/>
            </list>
        </field>
    </record>

    <!-- Checkpoint Checklist Item Form View -->
    <record id="view_checkpoint_checklist_item_form" model="ir.ui.view">
        <field name="name">checkpoint.checklist.item.form</field>
        <field name="model">project.checkpoint.checklist.item</field>
        <field name="arch" type="xml">
            <form string="Checkpoint Checklist Item">
                <header>
                    <button name="action_toggle_completion" type="object" 
                            string="Toggle Completion" class="btn-primary"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <!-- Status indicator -->
                        <div class="oe_stat_button" invisible="not is_completed">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_text">✅ Completed</span>
                            </div>
                        </div>
                    </div>
                    
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="checkpoint_id"/>
                            <field name="sequence"/>
                        </group>
                        <group>
                            <field name="is_required"/>
                            <field name="is_completed" widget="boolean_toggle"/>
                            <field name="completed_by" invisible="not is_completed"/>
                            <field name="completed_date" invisible="not is_completed"/>
                        </group>
                    </group>
                    
                    <notebook>
                        <page string="Description" name="description">
                            <field name="description" placeholder="Detailed description of this checklist item..."/>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="notes" placeholder="Additional notes about this checklist item..."/>
                        </page>
                        <page string="Template Info" name="template_info">
                            <group>
                                <field name="template_line_id" readonly="1"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Checkpoint Checklist Item Kanban View -->
    <record id="view_checkpoint_checklist_item_kanban" model="ir.ui.view">
        <field name="name">checkpoint.checklist.item.kanban</field>
        <field name="model">project.checkpoint.checklist.item</field>
        <field name="arch" type="xml">
            <kanban>
                <field name="id"/>
                <field name="name"/>
                <field name="is_completed"/>
                <field name="is_required"/>
                <field name="completed_by"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_card oe_kanban_global_click">
                            <div class="oe_kanban_content">
                                <div class="o_kanban_record_top">
                                    <div class="o_kanban_record_headings">
                                        <strong class="o_kanban_record_title">
                                            <t t-if="record.is_completed.raw_value">✅ </t>
                                            <t t-if="record.is_required.raw_value and !record.is_completed.raw_value">🔴 </t>
                                            <field name="name"/>
                                        </strong>
                                    </div>
                                </div>
                                <div class="o_kanban_record_bottom">
                                    <div class="oe_kanban_bottom_left">
                                        <t t-if="record.completed_by.raw_value">
                                            <span class="badge badge-pill badge-success">
                                                <field name="completed_by"/>
                                            </span>
                                        </t>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Checkpoint Checklist Template Line Views -->
    
    <!-- Checkpoint Checklist Template Line List View -->
    <record id="view_checkpoint_checklist_template_line_list" model="ir.ui.view">
        <field name="name">checkpoint.checklist.template.line.list</field>
        <field name="model">project.checkpoint.checklist.template.line</field>
        <field name="arch" type="xml">
            <list string="Checkpoint Checklist Template Lines" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="description"/>
                <field name="is_required"/>
                <field name="name_pattern"/>
                <field name="checkpoint_template_id" invisible="1"/>
            </list>
        </field>
    </record>

    <!-- Checkpoint Checklist Template Line Form View -->
    <record id="view_checkpoint_checklist_template_line_form" model="ir.ui.view">
        <field name="name">checkpoint.checklist.template.line.form</field>
        <field name="model">project.checkpoint.checklist.template.line</field>
        <field name="arch" type="xml">
            <form string="Checkpoint Checklist Template Line">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="checkpoint_template_id"/>
                            <field name="sequence"/>
                            <field name="is_required"/>
                        </group>
                    </group>
                    
                    <notebook>
                        <page string="Description" name="description">
                            <field name="description" placeholder="Template description for the checklist item..."/>
                        </page>
                        <page string="Patterns" name="patterns">
                            <group>
                                <field name="name_pattern" placeholder="e.g., Check {checkpoint} completion for {project}"/>
                                <field name="description_pattern" placeholder="e.g., Verify that {checkpoint} is properly completed for {task}"/>
                            </group>
                            <div class="alert alert-info" role="alert">
                                <strong>Pattern Variables:</strong>
                                <ul>
                                    <li><code>{checkpoint}</code> - Checkpoint name</li>
                                    <li><code>{sequence}</code> - Checklist item sequence</li>
                                    <li><code>{project}</code> - Project name</li>
                                    <li><code>{task}</code> - Task name</li>
                                </ul>
                            </div>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="notes" placeholder="Template notes for this checklist item..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- All Checkpoint Checklist Items Action -->
    <record id="action_project_checkpoint_checklist_item_all" model="ir.actions.act_window">
        <field name="name">All Checkpoint Checklists</field>
        <field name="res_model">project.checkpoint.checklist.item</field>
        <field name="view_mode">list,form,kanban</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No checkpoint checklist items found!
            </p>
            <p>
                Checklist items are automatically created when you apply checkpoint templates,
                or you can manually add them to any checkpoint.
            </p>
        </field>
    </record>

</odoo>
