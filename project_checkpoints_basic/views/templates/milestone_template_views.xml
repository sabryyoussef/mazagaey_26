<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- List View -->
        <record id="view_project_milestone_template_list" model="ir.ui.view">
            <field name="name">project.milestone.template.list</field>
            <field name="model">project.milestone.template</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name"/>
                    <field name="sequence"/>
                    <field name="milestone_name"/>
                    <field name="checkpoint_count"/>
                    <field name="milestone_deadline"/>
                    <field name="active"/>
                </list>
            </field>
        </record>

        <!-- Form View -->
        <record id="view_project_milestone_template_form" model="ir.ui.view">
            <field name="name">project.milestone.template.form</field>
            <field name="model">project.milestone.template</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button name="toggle_active" type="object" class="oe_stat_button" icon="fa-archive">
                                <field name="active" widget="boolean_button"/>
                            </button>
                            <button name="apply_to_current_project" 
                                    type="object" 
                                    string="Apply Template" 
                                    class="btn-primary"
                                    icon="fa-play"/>
                        </div>
                        <group>
                            <group>
                                <field name="name"/>
                                <field name="sequence"/>
                                <field name="project_id"/>
                            </group>
                            <group>
                                <field name="checkpoint_count"/>
                                <field name="milestone_deadline"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Milestone Configuration" name="milestone_config">
                                <group>
                                    <group>
                                        <field name="milestone_name"/>
                                        <field name="milestone_deadline"/>
                                    </group>
                                    <group>
                                        <field name="milestone_notes"/>
                                    </group>
                                </group>
                            </page>
                            <page string="Checkpoint Definitions" name="checkpoints">
                                <field name="checkpoint_line_ids">
                                    <list editable="bottom">
                                        <field name="sequence" widget="handle"/>
                                        <field name="name"/>
                                        <field name="tag_ids" widget="many2many_tags"/>
                                        <field name="auto_advance_stage"/>
                                        <field name="target_stage_id"/>
                                        <field name="notes"/>
                                    </list>
                                </field>
                            </page>
                            <page string="Template Notes" name="notes">
                                <field name="notes"/>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Action -->
        <record id="action_project_milestone_template" model="ir.actions.act_window">
            <field name="name">Milestone Templates</field>
            <field name="res_model">project.milestone.template</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create your first milestone template!
                </p>
                <p>
                    Milestone templates allow you to create predefined milestones with checkpoints
                    that can be applied to projects. This provides a consistent approach to
                    project milestone management.
                </p>
            </field>
        </record>

        <!-- Menu -->
        <menuitem id="menu_project_milestone_template"
                  name="Milestone Templates"
                  parent="project.menu_project_config"
                  action="action_project_milestone_template"
                  sequence="52"/>
    </data>
</odoo>
