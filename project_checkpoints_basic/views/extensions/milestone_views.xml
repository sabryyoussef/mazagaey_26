<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Inherit Milestone Form View -->
        <record id="view_project_milestone_form_inherit_checkpoints" model="ir.ui.view">
            <field name="name">project.milestone.form.inherit.checkpoints</field>
            <field name="model">project.milestone</field>
            <field name="inherit_id" ref="project.project_milestone_view_form"/>
            <field name="arch" type="xml">
                <!-- Add Smart Buttons -->
                <xpath expr="//div[@name='button_box']" position="inside">
                    <button name="%(action_project_task_checkpoint)d" 
                            type="action" 
                            string="Checkpoints" 
                            class="oe_stat_button"
                            icon="fa-flag-checkered"
                            invisible="checkpoint_count == 0">
                        <div class="o_form_field o_stat_info">
                            <span class="o_stat_value">
                                <field name="checkpoint_count" nolabel="1"/>
                                <span class="fw-normal"> Total</span>
                            </span>
                            <span class="o_stat_value" invisible="completed_checkpoint_count == 0">
                                <field name="completed_checkpoint_count" nolabel="1"/>
                                <span class="fw-normal"> Done</span>
                            </span>
                        </div>
                    </button>
                </xpath>
                
                <!-- Add Checkpoints tab -->
                <xpath expr="//sheet" position="inside">
                    <notebook>
                        <page string="Checkpoints" name="checkpoints">
                            <field name="checkpoint_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="task_id"/>
                                    <field name="is_reached"/>
                                    <field name="notes"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </xpath>
            </field>
        </record>
        
        <!-- Milestone List View -->
        <record id="view_project_milestone_list" model="ir.ui.view">
            <field name="name">project.milestone.list</field>
            <field name="model">project.milestone</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name"/>
                    <field name="project_id"/>
                    <field name="deadline"/>
                    <field name="is_reached"/>
                    <field name="checkpoint_count"/>
                    <field name="completed_checkpoint_count"/>
                    <field name="checkpoint_progress"/>
                </list>
            </field>
        </record>
        
        <!-- Milestone Form View (if standard one doesn't exist) -->
        <record id="view_project_milestone_form" model="ir.ui.view">
            <field name="name">project.milestone.form</field>
            <field name="model">project.milestone</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button name="%(action_project_task_checkpoint)d" 
                                    type="action" 
                                    string="Checkpoints" 
                                    class="oe_stat_button"
                                    icon="fa-flag-checkered"
                                    invisible="checkpoint_count == 0">
                                <div class="o_form_field o_stat_info">
                                    <span class="o_stat_value">
                                        <field name="checkpoint_count" nolabel="1"/>
                                        <span class="fw-normal"> Total</span>
                                    </span>
                                    <span class="o_stat_value" invisible="completed_checkpoint_count == 0">
                                        <field name="completed_checkpoint_count" nolabel="1"/>
                                        <span class="fw-normal"> Done</span>
                                    </span>
                                </div>
                            </button>
                        </div>
                        <group>
                            <group>
                                <field name="name"/>
                                <field name="project_id"/>
                            </group>
                            <group>
                                <field name="deadline"/>
                                <field name="is_reached"/>
                                <field name="checkpoint_count"/>
                                <field name="completed_checkpoint_count"/>
                                <field name="checkpoint_progress"/>
                            </group>
                        </group>
                        
                        <!-- Progress Bar Section -->
                        <group invisible="checkpoint_count == 0">
                            <field name="checkpoint_progress" widget="progressbar" string="Checkpoint Progress"/>
                        </group>
                        <notebook>
                            <page string="Checkpoints" name="checkpoints">
                                <field name="checkpoint_ids">
                                    <list editable="bottom">
                                        <field name="sequence" widget="handle"/>
                                        <field name="name"/>
                                        <field name="task_id"/>
                                        <field name="is_reached"/>
                                        <field name="notes"/>
                                    </list>
                                </field>
                            </page>
                            
                            <page string="Quotation Integration" name="quotation_integration">
                                <group>
                                    <field name="create_quotation_on_reach"/>
                                    <field name="quotation_template_id" invisible="not create_quotation_on_reach"/>
                                    <field name="quotation_notes" invisible="not create_quotation_on_reach"/>
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>
        
        <!-- Milestone Action -->
        <record id="action_project_milestone" model="ir.actions.act_window">
            <field name="name">Project Milestones</field>
            <field name="res_model">project.milestone</field>
            <field name="view_mode">list,form</field>
            <field name="view_ids" eval="[(5, 0, 0),
                (0, 0, {'view_mode': 'list', 'view_id': ref('view_project_milestone_list')}),
                (0, 0, {'view_mode': 'form', 'view_id': ref('view_project_milestone_form')})]"/>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create your first project milestone!
                </p>
                <p>
                    Milestones help you track major project deliverables and deadlines.
                </p>
            </field>
        </record>
    </data>
</odoo>
