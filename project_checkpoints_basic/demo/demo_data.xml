<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Demo Checkpoint Tags -->
        <record id="demo_checkpoint_tag_1" model="project.task.checkpoint.tag">
            <field name="name">Demo: Critical</field>
            <field name="color">1</field>
        </record>

        <record id="demo_checkpoint_tag_2" model="project.task.checkpoint.tag">
            <field name="name">Demo: Documentation</field>
            <field name="color">2</field>
        </record>

        <record id="demo_checkpoint_tag_3" model="project.task.checkpoint.tag">
            <field name="name">Demo: Testing</field>
            <field name="color">3</field>
        </record>

        <!-- Demo Milestone Templates -->
        <record id="demo_milestone_template_1" model="project.milestone.template">
            <field name="name">Demo: Project Kickoff</field>
            <field name="milestone_name">Project Kickoff</field>
            <field name="sequence">10</field>
            <field name="active">True</field>
            <field name="notes">Project kickoff milestone with initial setup</field>
        </record>

        <record id="demo_milestone_template_2" model="project.milestone.template">
            <field name="name">Demo: Phase 1 Complete</field>
            <field name="milestone_name">Phase 1 Complete</field>
            <field name="sequence">20</field>
            <field name="active">True</field>
            <field name="notes">Completion of first project phase</field>
        </record>

        <record id="demo_milestone_template_3" model="project.milestone.template">
            <field name="name">Demo: Final Delivery</field>
            <field name="milestone_name">Final Delivery</field>
            <field name="sequence">30</field>
            <field name="active">True</field>
            <field name="notes">Final project delivery milestone</field>
        </record>

        <!-- Demo Milestone Template Checkpoints -->
        <record id="demo_milestone_template_checkpoint_1" model="project.milestone.template.checkpoint">
            <field name="template_id" ref="demo_milestone_template_1"/>
            <field name="name">Demo: Project Setup Complete</field>
            <field name="sequence">10</field>
            <field name="auto_advance_stage">True</field>
            <field name="notes">All project setup tasks completed</field>
            <field name="tag_ids" eval="[(6, 0, [ref('demo_checkpoint_tag_1')])]"/>
        </record>

        <record id="demo_milestone_template_checkpoint_2" model="project.milestone.template.checkpoint">
            <field name="template_id" ref="demo_milestone_template_1"/>
            <field name="name">Demo: Team Assigned</field>
            <field name="sequence">20</field>
            <field name="auto_advance_stage">True</field>
            <field name="notes">Project team members assigned</field>
            <field name="tag_ids" eval="[(6, 0, [ref('demo_checkpoint_tag_2')])]"/>
        </record>

        <record id="demo_milestone_template_checkpoint_3" model="project.milestone.template.checkpoint">
            <field name="template_id" ref="demo_milestone_template_2"/>
            <field name="name">Demo: Requirements Validated</field>
            <field name="sequence">10</field>
            <field name="auto_advance_stage">True</field>
            <field name="notes">Project requirements validated with stakeholders</field>
            <field name="tag_ids" eval="[(6, 0, [ref('demo_checkpoint_tag_1'), ref('demo_checkpoint_tag_2')])]"/>
        </record>

        <record id="demo_milestone_template_checkpoint_4" model="project.milestone.template.checkpoint">
            <field name="template_id" ref="demo_milestone_template_2"/>
            <field name="name">Demo: Phase 1 Testing Complete</field>
            <field name="sequence">20</field>
            <field name="auto_advance_stage">True</field>
            <field name="notes">Phase 1 testing and validation completed</field>
            <field name="tag_ids" eval="[(6, 0, [ref('demo_checkpoint_tag_3')])]"/>
        </record>

        <record id="demo_milestone_template_checkpoint_5" model="project.milestone.template.checkpoint">
            <field name="template_id" ref="demo_milestone_template_3"/>
            <field name="name">Demo: Final Testing Complete</field>
            <field name="sequence">10</field>
            <field name="auto_advance_stage">True</field>
            <field name="notes">Final testing and quality assurance completed</field>
            <field name="tag_ids" eval="[(6, 0, [ref('demo_checkpoint_tag_3')])]"/>
        </record>

        <record id="demo_milestone_template_checkpoint_6" model="project.milestone.template.checkpoint">
            <field name="template_id" ref="demo_milestone_template_3"/>
            <field name="name">Demo: Documentation Complete</field>
            <field name="sequence">20</field>
            <field name="auto_advance_stage">True</field>
            <field name="notes">All project documentation completed</field>
            <field name="tag_ids" eval="[(6, 0, [ref('demo_checkpoint_tag_2')])]"/>
        </record>
    </data>
</odoo>
