    <!-- Document Processing Task Search View -->
    <record id="view_task_search_document_processing" model="ir.ui.view">
        <field name="name">project.task.search.document.processing</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_search_form"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <field name="document_id"/>
                <field name="document_category"/>
                <field name="document_processing_stage"/>
                
                <filter string="Document Processing Tasks" name="document_tasks" 
                        domain="[('document_id', '!=', False)]"/>
                <filter string="Upload Stage" name="upload_stage" 
                        domain="[('document_processing_stage', '=', 'upload')]"/>
                <filter string="Review Stage" name="review_stage" 
                        domain="[('document_processing_stage', '=', 'review')]"/>
                <filter string="Approval Stage" name="approval_stage" 
                        domain="[('document_processing_stage', '=', 'approval')]"/>
                <filter string="Delivery Stage" name="delivery_stage" 
                        domain="[('document_processing_stage', '=', 'delivery')]"/>
                <filter string="Completed" name="completed_stage" 
                        domain="[('document_processing_stage', '=', 'completed')]"/>
                
                <group expand="0" string="Group By">
                    <filter string="Document Category" name="group_document_category" 
                            context="{'group_by': 'document_category'}"/>
                    <filter string="Processing Stage" name="group_processing_stage" 
                            context="{'group_by': 'document_processing_stage'}"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
