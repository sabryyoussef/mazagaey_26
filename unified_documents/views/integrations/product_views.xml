<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Document Tree View for Product -->
    <record id="view_documents_document_tree_product" model="ir.ui.view">
        <field name="name">documents.document.tree.product</field>
        <field name="model">documents.document</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name"/>
                <field name="category"/>
                <field name="status"/>
                <field name="priority" widget="priority"/>
                <field name="expiry_date"/>
                <field name="is_expired" decoration-danger="is_expired"/>
                <field name="is_verified" decoration-success="is_verified"/>
                <button name="action_upload_file" type="object" 
                        string="Upload" icon="fa-upload" 
                        class="btn-sm btn-primary"/>
                <button name="action_view_document" type="object" 
                        string="View" icon="fa-eye" 
                        class="btn-sm btn-info"/>
            </list>
        </field>
    </record>

    <!-- Product List View for Document Copy Selection -->
    <record id="view_product_template_list_copy_selection" model="ir.ui.view">
        <field name="name">product.template.list.copy.selection</field>
        <field name="model">product.template</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="type"/>
                <field name="list_price"/>
                <field name="document_count"/>
                <field name="required_document_count"/>
                <field name="deliverable_document_count"/>
                <button name="action_copy_documents_to_project" type="object" 
                        string="Copy Documents" icon="fa-copy" 
                        class="btn-sm btn-primary"
                        context="{'default_target_project_id': context.get('default_target_project_id')}"/>
            </list>
        </field>
    </record>

    <!-- Extend Product Form View -->
    <record id="view_product_template_form_documents" model="ir.ui.view">
        <field name="name">product.template.form.documents</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Documents" name="documents">
                    <div class="oe_button_box" name="button_box">
                        <!-- Documents Smart Button -->
                        <button name="action_view_documents" type="object" 
                                class="oe_stat_button" icon="fa-file-text"
                                title="View All Documents">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_value">
                                    <field name="document_count"/>
                                </span>
                            </div>
                        </button>
                        
                        <!-- Required Documents Smart Button -->
                        <button name="action_view_required_documents" type="object" 
                                class="oe_stat_button" icon="fa-exclamation-triangle"
                                invisible="required_document_count == 0"
                                title="View Required Documents">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_value">
                                    <field name="required_document_count"/>
                                </span>
                            </div>
                        </button>
                        
                        <!-- No Required Documents Smart Button -->
                        <button name="action_view_documents" type="object" 
                                class="oe_stat_button" icon="fa-exclamation-triangle"
                                invisible="required_document_count != 0"
                                title="Add Required Documents">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_value">
                                    <i class="fa fa-plus"/>
                                </span>
                            </div>
                        </button>
                        
                        <!-- Deliverable Documents Smart Button -->
                        <button name="action_view_deliverable_documents" type="object" 
                                class="oe_stat_button" icon="fa-check-circle"
                                invisible="deliverable_document_count == 0"
                                title="View Deliverable Documents">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_value">
                                    <field name="deliverable_document_count"/>
                                </span>
                            </div>
                        </button>
                        
                        

                        
                        <!-- Copy to Project Smart Button -->
                        <button name="action_copy_documents_to_project" type="object" 
                                class="oe_stat_button" icon="fa-copy"
                                title="Copy Documents to Project">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_value">
                                    <i class="fa fa-copy"/>
                                </span>
                            </div>
                        </button>
                        
                        <!-- Fix Tags Smart Button -->
                        <button name="action_fix_document_tags" type="object" 
                                class="oe_stat_button" icon="fa-tags"
                                title="Fix Document Tags Display">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_value">
                                    <i class="fa fa-tags"/>
                                </span>
                            </div>
                        </button>
                        
                        <!-- Apply Template Smart Button -->
                        <button name="action_apply_product_template" type="object" 
                                class="oe_stat_button" icon="fa-magic"
                                title="Apply Product Template"
                                invisible="unified_product_template_id == False">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_value">
                                    <i class="fa fa-magic"/>
                                </span>
                            </div>
                        </button>
                        
                        <!-- View Template Smart Button -->
                        <button name="action_view_selected_template" type="object" 
                                class="oe_stat_button" icon="fa-eye"
                                title="View Selected Product Template"
                                invisible="unified_product_template_id == False">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_value">
                                    <i class="fa fa-eye"/>
                                </span>
                            </div>
                        </button>
                        
                        <!-- View Combined Templates Smart Button -->
                        <button name="action_view_combined_template_documents" type="object" 
                                class="oe_stat_button" icon="fa-list"
                                title="View Combined Template Documents"
                                invisible="unified_product_template_id == False and project_template_id == False">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_value">
                                    <i class="fa fa-list"/>
                                </span>
                            </div>
                        </button>
                        
                        <!-- Apply Combined Templates Smart Button -->
                        <button name="apply_combined_templates_to_product" type="object" 
                                class="oe_stat_button" icon="fa-magic"
                                title="Apply Combined Templates (Prevent Duplicates)"
                                invisible="unified_product_template_id == False and project_template_id == False">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_value">
                                    <i class="fa fa-magic"/>
                                </span>
                            </div>
                        </button>
                    </div>
                    
                    <group>
                        <group>
                            <field name="unified_product_template_id" 
                                   placeholder="Select a product template to add template documents"/>
                            <field name="required_document_count" readonly="1"/>
                            <field name="deliverable_document_count" readonly="1"/>
                        </group>
                    </group>
                    

                    
                    <!-- Document List Section -->
                    <group string="Product Documents">
                        <div class="d-flex justify-content-end mb-2">
                            <button name="action_refresh_documents" type="object" 
                                    string="Refresh List" class="btn-secondary"
                                    icon="fa-refresh"/>
                        </div>
                        <field name="document_ids" context="{'default_linked_product_id': id}">
                            <list editable="bottom">
                                <field name="name"/>
                                <field name="category"/>
                                <field name="status"/>
                                <field name="priority" widget="priority"/>
                                <field name="expiry_date"/>
                                <field name="is_expired" decoration-danger="is_expired"/>
                                <field name="is_verified" decoration-success="is_verified"/>
                                <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                                <button name="action_upload_file" type="object" 
                                        string="Upload" icon="fa-upload" 
                                        class="btn-sm btn-primary"/>
                                <button name="action_view_document" type="object" 
                                        string="View" icon="fa-eye" 
                                        class="btn-sm btn-info"/>
                            </list>
                        </field>
                    </group>
                    
                    <div class="alert alert-info" role="alert">
                        <strong>Product Templates:</strong> Select a product template from the dropdown above to add template documents to this product. The template will be applied when you save the product, or you can use the "Apply Template" button to apply immediately.
                        <br/><br/>
                        <strong>Combined Templates:</strong> If you have both a product template and a project template, use the "View Combined" and "Apply Combined" buttons to collect documents from both templates while preventing duplicates. Product template documents have priority over project template documents.
                        <br/><br/>
                        <strong>Smart Buttons:</strong> Use the smart buttons above to quickly access documents, create new ones, or copy to projects. Create document records above, then upload files using the Upload button in the document list.
                    </div>
                </page>
                
                <!-- Task Templates Tab -->
                <page string="Task Templates" name="task_templates" 
                      invisible="service_tracking != 'task_in_project'">
                    <div class="oe_button_box" name="button_box">
                        <!-- Task Templates Smart Button -->
                        <button name="action_view_task_templates" type="object" 
                                class="oe_stat_button" icon="fa-tasks"
                                title="View Task Templates">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_value">
                                    <field name="task_template_count"/>
                                </span>
                            </div>
                        </button>
                        
                        <!-- Project Template Smart Button -->
                        <button name="action_view_project_template" type="object" 
                                class="oe_stat_button" icon="fa-project-diagram"
                                invisible="project_template_id == False"
                                title="View Project Template">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_value">
                                    <i class="fa fa-project-diagram"/>
                                </span>
                            </div>
                        </button>
                        
                        <!-- Create Project Template Smart Button -->
                        <button name="action_create_custom_project_template" type="object" 
                                class="oe_stat_button" icon="fa-plus"
                                invisible="project_template_id != False"
                                title="Create Project Template">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_value">
                                    <i class="fa fa-plus"/>
                                </span>
                            </div>
                        </button>
                        
                        <!-- Create from Documents Smart Button -->
                        <button name="action_create_project_with_documents" type="object" 
                                class="oe_stat_button" icon="fa-file-text"
                                invisible="document_count == 0"
                                title="Create Project Template from Documents">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_value">
                                    <i class="fa fa-file-text"/>
                                </span>
                            </div>
                        </button>
                        
                        <!-- Test Document Copy Smart Button -->
                        <button name="action_test_document_copy" type="object" 
                                class="oe_stat_button" icon="fa-copy"
                                invisible="document_count == 0"
                                title="Test Document Copy to Project">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_value">
                                    <i class="fa fa-copy"/>
                                </span>
                            </div>
                        </button>
                    </div>
                    
                    <!-- Task Template Configuration -->
                    <group string="Task Template Configuration">
                        <group>
                            <field name="task_template_ids" 
                                   placeholder="Select task templates to add template tasks"/>
                        </group>
                        <group>
                            <button name="action_apply_task_templates" type="object" 
                                    string="Apply Task Templates" class="btn-primary"
                                    invisible="task_template_ids == False"/>
                            <button name="action_view_selected_task_templates" type="object" 
                                    string="View Task Templates" class="btn-secondary"
                                    invisible="task_template_ids == False"/>
                        </group>
                    </group>
                    
                    <!-- Project Template Configuration -->
                    <group string="Project Template Configuration">
                        <group>
                            <field name="create_project_template"/>
                            <field name="project_template_name" 
                                   invisible="create_project_template == False"
                                   placeholder="Enter custom template name (optional)"/>
                            <field name="project_template_id" readonly="1"/>
                        </group>
                        <group>
                            <button name="action_edit_project_template" type="object" 
                                    string="Edit Template" class="btn-secondary"
                                    invisible="project_template_id == False"/>
                            <button name="action_create_custom_project_template" type="object" 
                                    string="Create Template" class="btn-primary"
                                    invisible="project_template_id != False"/>
                        </group>
                    </group>
                    
                    <div class="alert alert-info" role="alert">
                        <strong>Task Templates:</strong> Select multiple task templates from the dropdown above to add template tasks to this product. The task templates will be applied when you save the product, or you can use the "Apply Task Templates" button to apply immediately. Tasks will be created when a project is created from this product.
                        <br/><br/>
                        <strong>Project Templates:</strong> Define project templates for this product. When the product is added to a project with "Project and Task" service tracking, these templates will be used to create tasks automatically.
                        <br/><br/>
                        <strong>Workflow:</strong> 
                        <ol>
                            <li>Select one or more task templates to apply to this product</li>
                            <li>Check "Auto-Create Project Template" to enable template creation</li>
                            <li>Optionally enter a custom "Project Template Name"</li>
                            <li>Save the product to automatically create the template, or use the "Create Template" button</li>
                            <li>The template will appear in the Project Templates menu</li>
                        </ol>
                    </div>
                </page>
            </xpath>
        </field>
    </record>

    <!-- Extend Product List View -->
    <record id="view_product_template_list_documents" model="ir.ui.view">
        <field name="name">product.template.list.documents</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_tree_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="unified_product_template_id"/>
                <field name="task_template_ids"/>
                <field name="document_count"/>
                <field name="required_document_count"/>
                <field name="deliverable_document_count"/>
            </xpath>
        </field>
    </record>
</odoo>
