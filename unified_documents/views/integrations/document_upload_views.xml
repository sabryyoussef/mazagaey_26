<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Custom form view for document uploads from projects -->
    <record id="view_documents_document_upload_form" model="ir.ui.view">
        <field name="name">Upload Document Form</field>
        <field name="model">documents.document</field>
        <field name="priority">50</field>
        <field name="arch" type="xml">
            <form string="Upload Document">
                <sheet>
                    <group>
                        <group>
                            <field name="name" placeholder="Document Name" required="True"/>
                            <field name="datas" string="Select File" filename="name" widget="binary" required="True"/>
                            <field name="folder_id" widget="documents_folder_many2one" 
                                   domain="[('type', '=', 'folder')]"
                                   options="{'no_create_edit': True}"/>
                        </group>
                        <group>
                            <field name="type" invisible="1"/>
                            <field name="category" string="Category"/>
                            <field name="tag_ids" widget="many2many_tags" 
                                   options="{'color_field': 'color'}"/>
                            <field name="owner_id" widget="many2one_avatar_user"/>
                        </group>
                    </group>
                    <group>
                        <field name="description" placeholder="Add a description..."/>
                    </group>
                    <!-- Hidden fields for project linking -->
                    <group invisible="1">
                        <field name="res_model"/>
                        <field name="res_id"/>
                        <field name="linked_project_id"/>
                    </group>
                </sheet>
                <footer>
                    <button string="Upload Document" type="object" name="action_upload_complete" class="btn-primary" data-hotkey="q"/>
                    <button string="Cancel" class="btn-secondary" special="cancel" data-hotkey="z"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
