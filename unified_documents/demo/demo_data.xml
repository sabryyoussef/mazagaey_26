<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Demo Document Copy Automation -->
        <record id="demo_document_copy_automation_1" model="unified.document.copy.automation">
            <field name="name">Demo: Project to Product Document Copy</field>
            <field name="trigger_model">project.project</field>
            <field name="source_model">project.project</field>
            <field name="target_model">product.template</field>
            <field name="copy_categories">all</field>
            <field name="copy_attachments">True</field>
            <field name="copy_tags">True</field>
            <field name="copy_notes">True</field>
            <field name="execution_type">on_create</field>
            <field name="active">True</field>
            <field name="sequence">10</field>
        </record>

        <record id="demo_document_copy_automation_2" model="unified.document.copy.automation">
            <field name="name">Demo: Sale Order to Project Document Copy</field>
            <field name="trigger_model">sale.order</field>
            <field name="source_model">sale.order</field>
            <field name="target_model">project.project</field>
            <field name="copy_categories">deliverable</field>
            <field name="copy_attachments">True</field>
            <field name="copy_tags">False</field>
            <field name="copy_notes">True</field>
            <field name="execution_type">on_write</field>
            <field name="active">True</field>
            <field name="sequence">20</field>
        </record>

        <!-- Demo Product Templates -->
        <record id="demo_product_template_1" model="unified.product.template">
            <field name="name">Demo: Software Development Template</field>
            <field name="description">Template for software development projects with standard documents</field>
            <field name="template_type">document_based</field>
            <field name="active">True</field>
            <field name="sequence">10</field>
        </record>

        <record id="demo_product_template_2" model="unified.product.template">
            <field name="name">Demo: Consulting Services Template</field>
            <field name="description">Template for consulting services with client deliverables</field>
            <field name="template_type">service_based</field>
            <field name="active">True</field>
            <field name="sequence">20</field>
        </record>
    </data>
</odoo>
