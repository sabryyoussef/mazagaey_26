        <!-- Company Formation Document Automation -->
        <record id="demo_automation_company_formation_docs" model="unified.document.copy.automation">
            <field name="name">Company Formation Document Copy</field>
            <field name="sequence">10</field>
            <field name="active">True</field>
            <field name="trigger_model">project.project</field>
            <field name="source_model">product.template</field>
            <field name="source_fallback" ref="demo_product_company_formation_dmcc"/>
            <field name="target_model">project.project</field>
            <field name="copy_categories">all</field>
            <field name="copy_attachments">True</field>
            <field name="copy_tags">True</field>
            <field name="copy_notes">True</field>
            <field name="execution_type">on_create</field>
            <field name="error_notification">True</field>
            <field name="log_executions">True</field>
