<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- Unified Documents User Group -->
        <record id="group_unified_documents_user" model="res.groups">
            <field name="name">Unified Documents User</field>
            <field name="category_id" ref="base.module_category_hidden"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="comment">Users can copy documents and use basic automation features.</field>
        </record>

        <!-- Unified Documents Manager Group -->
        <record id="group_unified_documents_manager" model="res.groups">
            <field name="name">Unified Documents Manager</field>
            <field name="category_id" ref="base.module_category_hidden"/>
            <field name="implied_ids" eval="[(4, ref('group_unified_documents_user')), (4, ref('project.group_project_manager'))]"/>
            <field name="comment">Managers can create and manage document copy automations.</field>
        </record>

        <!-- Unified Documents Administrator Group -->
        <record id="group_unified_documents_admin" model="res.groups">
            <field name="name">Unified Documents Administrator</field>
            <field name="category_id" ref="base.module_category_hidden"/>
            <field name="implied_ids" eval="[(4, ref('group_unified_documents_manager')), (4, ref('base.group_system'))]"/>
            <field name="comment">Administrators have full access to all unified documents features.</field>
        </record>
    </data>
</odoo>
