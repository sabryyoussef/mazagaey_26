<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Extend Project Task Form View -->
        <record id="view_unified_project_task_form_template_inherit" model="ir.ui.view">
            <field name="name">unified.project.task.form.template.inherit</field>
            <field name="model">project.task</field>
            <field name="inherit_id" ref="project.view_task_form2"/>
            <field name="arch" type="xml">
                <!-- Add template smart button -->
                <xpath expr="//div[@name='button_box']" position="inside">
                    <button name="action_create_from_template" 
                            type="object" 
                            class="oe_stat_button" 
                            icon="fa-file-text"
                            title="Apply Template"
                            invisible="task_template_id != False">
                        <div class="o_field_widget o_stat_info">
                            <span class="o_stat_value">
                                <i class="fa fa-plus"/>
                            </span>
                            <span class="o_stat_text">Apply Template</span>
                        </div>
                    </button>
                    
                    <button name="action_view_checklist" 
                            type="object" 
                            class="oe_stat_button" 
                            icon="fa-check-square-o"
                            title="View Checklist"
                            invisible="checklist_total_count == 0">
                        <div class="o_field_widget o_stat_info">
                            <span class="o_stat_value">
                                <field name="checklist_completed_count"/>/<field name="checklist_total_count"/>
                            </span>
                            <span class="o_stat_text">Checklist Items</span>
                        </div>
                    </button>
                    
                    <button name="action_view_template_usage" 
                            type="object" 
                            class="oe_stat_button" 
                            icon="fa-history"
                            title="Template Usage History"
                            invisible="not task_template_id">
                        <div class="o_field_widget o_stat_info">
                            <span class="o_stat_value">
                                <i class="fa fa-history"/>
                            </span>
                            <span class="o_stat_text">Template History</span>
                        </div>
                    </button>
                </xpath>
                
                <!-- Add template information group -->
                <xpath expr="//group" position="after">
                    <group name="template_info" string="Template Information" 
                           invisible="not task_template_id">
                        <group>
                            <field name="task_template_id" readonly="1"/>
                            <field name="checklist_completion_percentage" widget="progressbar"/>
                        </group>
                        <group>
                            <field name="checklist_total_count" readonly="1"/>
                            <field name="checklist_completed_count" readonly="1"/>
                        </group>
                    </group>
                </xpath>
                
                <!-- Add checklist tab -->
                <xpath expr="//notebook" position="inside">
                    <page string="Checklist" name="checklist" 
                          invisible="checklist_total_count == 0">
                        <div class="d-flex justify-content-end mb-2">
                            <button name="action_view_checklist" 
                                    type="object" 
                                    string="Manage Checklist" 
                                    class="btn-secondary"
                                    icon="fa-edit"/>
                        </div>
                        <field name="checklist_item_ids" readonly="1">
                            <list>
                                <field name="sequence" widget="handle"/>
                                <field name="name"/>
                                <field name="is_required"/>
                                <field name="is_completed"/>
                                <field name="completed_by"/>
                                <field name="completed_date"/>
                                <button name="action_toggle_completion" 
                                        type="object" 
                                        string="Toggle" 
                                        icon="fa-check"
                                        class="btn-sm btn-primary"/>
                            </list>
                        </field>
                    </page>
                </xpath>
            </field>
        </record>

        <!-- Extend Project Task List View -->
        <record id="view_unified_project_task_list_template_inherit" model="ir.ui.view">
            <field name="name">unified.project.task.list.template.inherit</field>
            <field name="model">project.task</field>
            <field name="inherit_id" ref="project.view_task_tree2"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='name']" position="after">
                    <field name="task_template_id" optional="show"/>
                    <field name="checklist_completion_percentage" widget="progressbar" optional="show"/>
                </xpath>
            </field>
        </record>

        <!-- Task Checklist Kanban View -->
        <record id="view_unified_task_checklist_kanban" model="ir.ui.view">
            <field name="name">unified.task.checklist.kanban</field>
            <field name="model">project.checklist.item</field>
            <field name="arch" type="xml">
                <kanban>
                    <field name="id"/>
                    <field name="name"/>
                    <field name="description"/>
                    <field name="is_required"/>
                    <field name="is_completed"/>
                    <field name="completed_by"/>
                    <field name="completed_date"/>
                    <field name="sequence"/>
                    <templates>
                        <t t-name="kanban-box">
                            <div class="oe_kanban_card oe_kanban_global_click">
                                <div class="oe_kanban_content">
                                    <div class="o_kanban_record_top">
                                        <div class="o_kanban_record_headings">
                                            <strong class="o_kanban_record_title">
                                                <field name="name"/>
                                            </strong>
                                        </div>
                                        <div class="o_kanban_record_top_right">
                                            <field name="is_completed" widget="boolean_toggle"/>
                                        </div>
                                    </div>
                                    <div class="o_kanban_record_body">
                                        <field name="description"/>
                                    </div>
                                    <div class="o_kanban_record_bottom">
                                        <div class="oe_kanban_bottom_left">
                                            <span class="badge badge-pill" 
                                                  t-attf-class="badge-#{record.is_required.raw_value ? 'warning' : 'info'}">
                                                <t t-if="record.is_required.raw_value">Required</t>
                                                <t t-else="">Optional</t>
                                            </span>
                                        </div>
                                        <div class="oe_kanban_bottom_right">
                                            <field name="completed_by"/>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>
    </data>
</odoo>
