<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Project Document Template List View -->
        <record id="view_project_document_template_list" model="ir.ui.view">
            <field name="name">project.document.template.list</field>
            <field name="model">project.document.template</field>
            <field name="arch" type="xml">
                <list>
                    <field name="sequence" widget="handle"/>
                    <field name="name"/>
                    <field name="template_type"/>
                    <field name="document_count"/>
                    <field name="checklist_count"/>
                    <field name="usage_count"/>
                    <field name="auto_apply"/>
                    <field name="active"/>
                </list>
            </field>
        </record>

        <!-- Project Document Template Form View -->
        <record id="view_project_document_template_form" model="ir.ui.view">
            <field name="name">project.document.template.form</field>
            <field name="model">project.document.template</field>
            <field name="arch" type="xml">
                <form>
                    <header>
                        <button name="action_preview_template" 
                                type="object" 
                                string="Preview Template" 
                                class="btn-secondary"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <field name="name" placeholder="Template Name"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="sequence"/>
                                <field name="template_type"/>
                                <field name="active"/>
                            </group>
                            <group>
                                <field name="document_count"/>
                                <field name="checklist_count"/>
                                <field name="usage_count"/>
                            </group>
                        </group>
                        <field name="description"/>
                        <notebook>
                            <page string="Document Template Lines" name="document_lines">
                                <field name="document_template_line_ids">
                                    <list editable="bottom">
                                        <field name="sequence" widget="handle"/>
                                        <field name="name"/>
                                        <field name="category"/>
                                        <field name="priority"/>
                                        <field name="tag_ids" widget="many2many_tags"/>
                                    </list>
                                </field>
                            </page>
                            <page string="Checklist Template Lines" name="checklist_lines">
                                <field name="checklist_template_line_ids">
                                    <list editable="bottom">
                                        <field name="sequence" widget="handle"/>
                                        <field name="name"/>
                                        <field name="is_required"/>
                                    </list>
                                </field>
                            </page>
                            <page string="Application Settings" name="settings">
                                <group>
                                    <group>
                                        <field name="auto_apply"/>
                                        <field name="apply_to_projects"/>
                                        <field name="apply_to_tasks"/>
                                    </group>
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Project Document Template Preview View -->
        <record id="view_project_document_template_preview" model="ir.ui.view">
            <field name="name">project.document.template.preview</field>
            <field name="model">project.document.template</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <field name="name" readonly="1"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="template_type" readonly="1"/>
                                <field name="document_count" readonly="1"/>
                                <field name="checklist_count" readonly="1"/>
                            </group>
                        </group>
                        <field name="description" readonly="1"/>
                        <notebook>
                            <page string="Document Template Lines" name="document_lines">
                                <field name="document_template_line_ids" readonly="1">
                                    <list>
                                        <field name="sequence"/>
                                        <field name="name"/>
                                        <field name="category"/>
                                        <field name="priority"/>
                                        <field name="tag_ids" widget="many2many_tags"/>
                                        <field name="notes"/>
                                    </list>
                                </field>
                            </page>
                            <page string="Checklist Template Lines" name="checklist_lines">
                                <field name="checklist_template_line_ids" readonly="1">
                                    <list>
                                        <field name="sequence"/>
                                        <field name="name"/>
                                        <field name="description"/>
                                        <field name="is_required"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Project Document Template Action -->
        <record id="action_project_document_template" model="ir.actions.act_window">
            <field name="name">Project Document Templates</field>
            <field name="res_model">project.document.template</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create your first task document template!
                </p>
                <p>
                    Task document templates allow you to predefine sets of documents and checklist items
                    that can be automatically applied to tasks.
                </p>
            </field>
        </record>

        <!-- Project Checklist Item List View -->
        <record id="view_project_checklist_item_list" model="ir.ui.view">
            <field name="name">project.checklist.item.list</field>
            <field name="model">project.checklist.item</field>
            <field name="arch" type="xml">
                <list>
                    <field name="sequence" widget="handle"/>
                    <field name="name"/>
                    <field name="is_required"/>
                    <field name="is_completed"/>
                    <field name="completed_by"/>
                    <field name="completed_date"/>
                </list>
            </field>
        </record>

        <!-- Project Checklist Item Form View -->
        <record id="view_project_checklist_item_form" model="ir.ui.view">
            <field name="name">project.checklist.item.form</field>
            <field name="model">project.checklist.item</field>
            <field name="arch" type="xml">
                <form>
                    <header>
                        <button name="action_toggle_completion" 
                                type="object" 
                                string="Toggle Completion" 
                                class="btn-primary"/>
                    </header>
                    <sheet>
                        <group>
                            <group>
                                <field name="sequence"/>
                                <field name="is_required"/>
                                <field name="is_completed"/>
                            </group>
                            <group>
                                <field name="completed_by"/>
                                <field name="completed_date"/>
                            </group>
                        </group>
                        <field name="name"/>
                        <field name="description"/>
                        <field name="task_id"/>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Project Template Usage List View -->
        <record id="view_project_template_usage_list" model="ir.ui.view">
            <field name="name">project.template.usage.list</field>
            <field name="model">project.template.usage</field>
            <field name="arch" type="xml">
                <list>
                    <field name="template_id"/>
                    <field name="task_id"/>
                    <field name="applied_by"/>
                    <field name="applied_date"/>
                    <field name="documents_created"/>
                    <field name="checklist_items_created"/>
                </list>
            </field>
        </record>

        <!-- Project Template Usage Form View -->
        <record id="view_project_template_usage_form" model="ir.ui.view">
            <field name="name">project.template.usage.form</field>
            <field name="model">project.template.usage</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <group>
                                <field name="template_id"/>
                                <field name="task_id"/>
                            </group>
                            <group>
                                <field name="applied_by"/>
                                <field name="applied_date"/>
                            </group>
                        </group>
                        <group>
                            <group>
                                <field name="documents_created"/>
                                <field name="checklist_items_created"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>
    </data>
</odoo>
