<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Project Document Template List View -->
        <record id="view_project_document_template_list" model="ir.ui.view">
            <field name="name">project.document.template.list</field>
            <field name="model">project.document.template</field>
            <field name="arch" type="xml">
                <list>
                    <field name="sequence" widget="handle"/>
                    <field name="name"/>
                    <field name="template_type"/>
                    <field name="document_count"/>
                    <field name="checklist_count"/>
                    <field name="usage_count"/>
                    <field name="auto_apply"/>
                    <field name="active"/>
                </list>
            </field>
        </record>

        <!-- Project Document Template Form View -->
        <record id="view_project_document_template_form" model="ir.ui.view">
            <field name="name">project.document.template.form</field>
            <field name="model">project.document.template</field>
            <field name="arch" type="xml">
                <form>
                    <header>
                        <button name="action_preview_template" 
                                type="object" 
                                string="Preview Template" 
                                class="btn-secondary"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <field name="name" placeholder="Template Name"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="sequence"/>
                                <field name="template_type"/>
                                <field name="active"/>
                            </group>
                            <group>
                                <field name="document_count"/>
                                <field name="checklist_count"/>
                                <field name="usage_count"/>
                            </group>
                        </group>
                        <field name="description"/>
                        <notebook>
                            <page string="Document Template Lines" name="document_lines">
                                <field name="document_template_line_ids">
                                    <list editable="bottom">
                                        <field name="sequence" widget="handle"/>
                                        <field name="name"/>
                                        <field name="category"/>
                                        <field name="priority"/>
                                        <field name="tag_ids" widget="many2many_tags"/>
                                    </list>
                                </field>
                            </page>
                            <page string="Checklist Template Lines" name="checklist_lines">
                                <field name="checklist_template_line_ids">
                                    <list editable="bottom">
                                        <field name="sequence" widget="handle"/>
                                        <field name="name"/>
                                        <field name="is_required"/>
                                    </list>
                                </field>
                            </page>
                            <page string="Application Settings" name="settings">
                                <group>
                                    <group>
                                        <field name="auto_apply"/>
                                        <field name="apply_to_projects"/>
                                        <field name="apply_to_tasks"/>
                                    </group>
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Project Document Template Preview View -->
        <record id="view_project_document_template_preview" model="ir.ui.view">
            <field name="name">project.document.template.preview</field>
            <field name="model">project.document.template</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <field name="name" readonly="1"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="template_type" readonly="1"/>
                                <field name="document_count" readonly="1"/>
                                <field name="checklist_count" readonly="1"/>
                            </group>
                            <group>
                                <field name="usage_count" readonly="1"/>
                                <field name="auto_apply" readonly="1"/>
                                <field name="active" readonly="1"/>
                            </group>
                        </group>
                        <field name="description" readonly="1"/>
                        <notebook>
                            <page string="Document Template Lines" name="document_lines_preview">
                                <field name="document_template_line_ids" readonly="1">
                                    <list>
                                        <field name="sequence"/>
                                        <field name="name"/>
                                        <field name="category"/>
                                        <field name="priority"/>
                                        <field name="tag_ids" widget="many2many_tags"/>
                                    </list>
                                </field>
                            </page>
                            <page string="Checklist Template Lines" name="checklist_lines_preview">
                                <field name="checklist_template_line_ids" readonly="1">
                                    <list>
                                        <field name="sequence"/>
                                        <field name="name"/>
                                        <field name="is_required"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Project Document Template Search View -->
        <record id="view_project_document_template_search" model="ir.ui.view">
            <field name="name">project.document.template.search</field>
            <field name="model">project.document.template</field>
            <field name="arch" type="xml">
                <search>
                    <field name="name"/>
                    <field name="template_type"/>
                    <filter string="Document-Based" name="document_based" domain="[('template_type', '=', 'document_based')]"/>
                    <filter string="Checklist-Based" name="checklist_based" domain="[('template_type', '=', 'checklist_based')]"/>
                    <filter string="Hybrid" name="hybrid" domain="[('template_type', '=', 'hybrid')]"/>
                    <filter string="Auto-Apply" name="auto_apply" domain="[('auto_apply', '=', True)]"/>
                    <filter string="Active" name="active" domain="[('active', '=', True)]"/>
                    <group expand="0" string="Group By">
                        <filter string="Template Type" name="group_template_type" context="{'group_by': 'template_type'}"/>
                        <filter string="Auto-Apply" name="group_auto_apply" context="{'group_by': 'auto_apply'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- Project Document Template Action -->
        <record id="action_project_document_template" model="ir.actions.act_window">
            <field name="name">Document Templates</field>
            <field name="res_model">project.document.template</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create your first document template!
                </p>
                <p>
                    Document templates allow you to create predefined document structures
                    that can be applied to projects and tasks for consistent documentation.
                </p>
            </field>
        </record>
    </data>
</odoo>
