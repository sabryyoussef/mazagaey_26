<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Task Template Tree View -->
    <record id="view_project_task_template_tree" model="ir.ui.view">
        <field name="name">project.task.template.tree</field>
        <field name="model">project.task.template</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="template_type"/>
                <field name="document_category"/>
                <field name="priority" widget="priority"/>
                <field name="estimated_hours"/>
                <field name="usage_count"/>

                <field name="milestone_template_ids" widget="many2many_tags"/>
                <field name="document_template_ids" widget="many2many_tags"/>
                <field name="checkpoint_template_ids" widget="many2many_tags"/>
                <field name="sequence" widget="handle"/>
                <field name="active" invisible="1"/>
            </list>
        </field>
    </record>

    <!-- Task Template Form View -->
    <record id="view_project_task_template_form" model="ir.ui.view">
        <field name="name">project.task.template.form</field>
        <field name="model">project.task.template</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_create_task_from_template" type="object" 
                            string="Create Task" class="btn-primary"/>
                    <button name="action_view_usage" type="object" 
                            string="View Usage" class="btn-secondary"/>
                </header>
                
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <!-- Usage Count Smart Button -->
                        <button name="action_view_usage" type="object" 
                                class="oe_stat_button" icon="fa-chart-line"
                                title="View Template Usage">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_value">
                                    <field name="usage_count"/>
                                </span>
                                <span class="o_stat_text">Usage</span>
                            </div>
                        </button>
                        

                        
                        <!-- Milestone Templates Smart Button -->
                        <button name="action_view_milestone_templates" type="object" 
                                class="oe_stat_button" icon="fa-flag"
                                title="View Milestone Templates"
                                invisible="milestone_template_ids == False">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_value">
                                    <i class="fa fa-flag"/>
                                </span>
                                <span class="o_stat_text">Milestones</span>
                            </div>
                        </button>
                        
                        <!-- Document Templates Smart Button -->
                        <button name="action_view_document_templates" type="object" 
                                class="oe_stat_button" icon="fa-file-text"
                                title="View Document Templates"
                                invisible="document_template_ids == False">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_value">
                                    <i class="fa fa-file-text"/>
                                </span>
                                <span class="o_stat_text">Documents</span>
                            </div>
                        </button>
                        
                        <!-- Checkpoint Templates Smart Button -->
                        <button name="action_view_checkpoint_templates" type="object" 
                                class="oe_stat_button" icon="fa-check-square-o"
                                title="View Checkpoint Templates"
                                invisible="checkpoint_template_ids == False">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_value">
                                    <i class="fa fa-check-square-o"/>
                                </span>
                                <span class="o_stat_text">Checkpoints</span>
                            </div>
                        </button>
                    </div>
                    
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="template_type"/>
                            <field name="document_category"/>
                            <field name="sequence"/>
                        </group>
                        <group>
                            <field name="priority" widget="priority"/>
                            <field name="estimated_hours"/>
                            <field name="active"/>
                        </group>
                    </group>
                    
                    <notebook>
                        <page string="Description" name="description">
                            <field name="description" placeholder="Describe this task template..."/>
                        </page>
                        
                        <page string="Task Configuration" name="task_configuration">
                            <group>
                                <group>
                                    <field name="task_name_pattern" 
                                           placeholder="e.g., Complete {category} Documents ({count} items)"/>
                                    <field name="task_description_pattern" 
                                           placeholder="e.g., Complete all {category} documents for {project}"/>
                                </group>
                                <group>
                                    <field name="prerequisite_task_ids" widget="many2many_tags"/>
                                </group>
                            </group>
                            
                            <div class="alert alert-info" role="alert">
                                <strong>Pattern Variables:</strong>
                                <ul>
                                    <li><code>{category}</code> - Document category (Required, Deliverable, etc.)</li>
                                    <li><code>{count}</code> - Number of documents in the category</li>
                                    <li><code>{project}</code> - Project name</li>
                                    <li><code>{template}</code> - Template name</li>
                                    <li><code>{description}</code> - Template description</li>
                                </ul>
                            </div>
                        </page>
                        
                        <page string="Usage History" name="usage_history">
                            <field name="usage_count" readonly="1"/>
                            <p class="text-muted">Click "View Usage" button to see detailed usage history.</p>
                        </page>
                        

                        
                        <page string="Milestone Templates" name="milestone_templates">
                            <group string="Milestone Template Configuration">
                                <group>
                                    <field name="milestone_template_ids" 
                                           placeholder="Select milestone templates for this task template"/>
                                </group>
                                <group>
                                    <button name="action_create_milestone_template" type="object" 
                                            string="Create New Milestone Template" class="btn-primary"
                                            invisible="milestone_template_ids != False"/>
                                    <button name="action_view_milestone_templates" type="object" 
                                            string="View Milestone Templates" class="btn-secondary"
                                            invisible="milestone_template_ids == False"/>
                                </group>
                            </group>
                            
                            <div class="alert alert-info" role="alert">
                                <strong>Milestone Templates:</strong> Select milestone templates to associate with this task template. When this task template is applied, the associated milestone templates will also be applied.
                                <br/><br/>
                                <strong>Workflow:</strong>
                                <ol>
                                    <li>Select existing milestone templates from the dropdown, or</li>
                                    <li>Click "Create New Milestone Template" to create a new one</li>
                                    <li>Click "View Milestone Templates" to see selected templates</li>
                                    <li>Milestone templates will be applied when this task template is used</li>
                                </ol>
                            </div>
                        </page>
                        
                        <page string="Document Templates" name="document_templates">
                            <group string="Document Template Configuration">
                                <group>
                                    <field name="document_template_ids" 
                                           placeholder="Select document templates for this task template"/>
                                </group>
                                <group>
                                    <button name="action_create_document_template" type="object" 
                                            string="Create New Document Template" class="btn-primary"
                                            invisible="document_template_ids != False"/>
                                    <button name="action_view_document_templates" type="object" 
                                            string="View Document Templates" class="btn-secondary"
                                            invisible="document_template_ids == False"/>
                                </group>
                            </group>
                            
                            <div class="alert alert-info" role="alert">
                                <strong>Document Templates:</strong> Select document templates to associate with this task template. When this task template is applied, the associated document templates will also be applied.
                                <br/><br/>
                                <strong>Workflow:</strong>
                                <ol>
                                    <li>Select existing document templates from the dropdown, or</li>
                                    <li>Click "Create New Document Template" to create a new one</li>
                                    <li>Click "View Document Templates" to see selected templates</li>
                                    <li>Document templates will be applied when this task template is used</li>
                                </ol>
                                <br/>
                                <strong>Document Template Types:</strong>
                                <ul>
                                    <li><strong>Document-Based:</strong> Templates with predefined document structures</li>
                                    <li><strong>Checklist-Based:</strong> Templates with task-oriented checklists</li>
                                    <li><strong>Hybrid:</strong> Templates with both documents and checklists</li>
                                </ul>
                            </div>
                        </page>
                        
                        <page string="Checkpoint Templates" name="checkpoint_templates">
                            <group string="Checkpoint Template Configuration">
                                <group>
                                    <field name="checkpoint_template_ids" 
                                           placeholder="Select checkpoint templates for this task template"/>
                                </group>
                                <group>
                                    <button name="action_create_checkpoint_template" type="object" 
                                            string="Create New Checkpoint Template" class="btn-primary"
                                            invisible="checkpoint_template_ids != False"/>
                                    <button name="action_view_checkpoint_templates" type="object" 
                                            string="View Checkpoint Templates" class="btn-secondary"
                                            invisible="checkpoint_template_ids == False"/>
                                </group>
                            </group>
                            
                            <div class="alert alert-info" role="alert">
                                <strong>Checkpoint Templates:</strong> Select checkpoint templates to associate with this task template. When this task template is applied, the associated checkpoint templates will also be applied.
                                <br/><br/>
                                <strong>Workflow:</strong>
                                <ol>
                                    <li>Select existing checkpoint templates from the dropdown, or</li>
                                    <li>Click "Create New Checkpoint Template" to create a new one</li>
                                    <li>Click "View Checkpoint Templates" to see selected templates</li>
                                    <li>Checkpoint templates will be applied when this task template is used</li>
                                </ol>
                                <br/>
                                <strong>Checkpoint Features:</strong>
                                <ul>
                                    <li><strong>Progress Tracking:</strong> Monitor task completion through checkpoints</li>
                                    <li><strong>Quality Control:</strong> Ensure all requirements are met before proceeding</li>
                                    <li><strong>Checklist Integration:</strong> Each checkpoint can have its own checklist items</li>
                                    <li><strong>Status Management:</strong> Track checkpoint completion status</li>
                                </ul>
                            </div>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Task Template Search View -->
    <record id="view_project_task_template_search" model="ir.ui.view">
        <field name="name">project.task.template.search</field>
        <field name="model">project.task.template</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="template_type"/>
                <field name="document_category"/>
                
                <filter string="Document-Based" name="document_based" domain="[('template_type', '=', 'document_based')]"/>
                <filter string="Progress Tracking" name="progress_tracking" domain="[('template_type', '=', 'progress_tracking')]"/>
                <filter string="Milestone" name="milestone" domain="[('template_type', '=', 'milestone')]"/>
                <filter string="Custom" name="custom" domain="[('template_type', '=', 'custom')]"/>
                
                <filter string="Required Documents" name="required" domain="[('document_category', '=', 'required')]"/>
                <filter string="Deliverable Documents" name="deliverable" domain="[('document_category', '=', 'deliverable')]"/>
                <filter string="Reference Documents" name="reference" domain="[('document_category', '=', 'reference')]"/>
                <filter string="Compliance Documents" name="compliance" domain="[('document_category', '=', 'compliance')]"/>
                <filter string="All Documents" name="all_documents" domain="[('document_category', '=', 'all')]"/>
                
                <filter string="Active" name="active" domain="[('active', '=', True)]"/>
                <filter string="Inactive" name="inactive" domain="[('active', '=', False)]"/>
                
                <group expand="0" string="Group By">
                    <filter string="Template Type" name="group_template_type" context="{'group_by': 'template_type'}"/>
                    <filter string="Document Category" name="group_document_category" context="{'group_by': 'document_category'}"/>
                    <filter string="Priority" name="group_priority" context="{'group_by': 'priority'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Task Template Action -->
    <record id="action_project_task_template" model="ir.actions.act_window">
        <field name="name">Task Templates</field>
        <field name="res_model">project.task.template</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first task template!
            </p>
            <p>
                Task templates help you standardize task creation from project templates.
                Create templates that can generate tasks based on document categories, progress tracking, or milestones.
            </p>
        </field>
    </record>

    <!-- Task Template Usage Tree View -->
    <record id="view_project_task_template_usage_tree" model="ir.ui.view">
        <field name="name">project.task.template.usage.tree</field>
        <field name="model">project.task.template.usage</field>
        <field name="arch" type="xml">
            <list>
                <field name="task_template_id"/>
                <field name="project_template_id"/>
                <field name="project_id"/>
                <field name="task_id"/>
                <field name="document_category"/>
                <field name="document_count"/>
                <field name="applied_by"/>
                <field name="applied_date"/>
            </list>
        </field>
    </record>

    <!-- Task Template Usage Form View -->
    <record id="view_project_task_template_usage_form" model="ir.ui.view">
        <field name="name">project.task.template.usage.form</field>
        <field name="model">project.task.template.usage</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="task_template_id"/>
                            <field name="project_template_id"/>
                            <field name="project_id"/>
                            <field name="task_id"/>
                        </group>
                        <group>
                            <field name="document_category"/>
                            <field name="document_count"/>
                            <field name="applied_by"/>
                            <field name="applied_date"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Task Template Usage Action -->
    <record id="action_project_task_template_usage" model="ir.actions.act_window">
        <field name="name">Task Template Usage</field>
        <field name="res_model">project.task.template.usage</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No usage records found!
            </p>
            <p>
                Usage records are created when task templates are applied to projects.
            </p>
        </field>
    </record>
</odoo>
