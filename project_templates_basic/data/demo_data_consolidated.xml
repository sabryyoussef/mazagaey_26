        <!-- ========================================
             SECTION 2: CHECKPOINT TEMPLATES
             ======================================== -->
        
        <!-- Checkpoint Template 1: Company Formation -->
        <record id="checkpoint_template_company_formation" model="project.checkpoint.template">
            <field name="name">Company Formation – Base</field>
            <field name="sequence">10</field>
            <field name="active">True</field>
            <field name="notes">Standard company formation process for UAE businesses</field>
        </record>
        
        <!-- Template Lines for Company Formation -->
        <record id="checkpoint_line_passport" model="project.checkpoint.template.line">
            <field name="name">Collect Passport Copy</field>
            <field name="sequence">10</field>
            <field name="template_id" ref="checkpoint_template_company_formation"/>
            <field name="auto_advance_stage">True</field>
            <field name="notes">Valid passport copy collected</field>
        </record>
        
        <record id="checkpoint_line_trade_name" model="project.checkpoint.template.line">
            <field name="name">Reserve Trade Name</field>
            <field name="sequence">20</field>
            <field name="template_id" ref="checkpoint_template_company_formation"/>
            <field name="auto_advance_stage">True</field>
            <field name="notes">Trade name reserved with authorities</field>
        </record>
        
        <record id="checkpoint_line_payment" model="project.checkpoint.template.line">
            <field name="name">Process Initial Payment</field>
            <field name="sequence">30</field>
            <field name="template_id" ref="checkpoint_template_company_formation"/>
            <field name="auto_advance_stage">True</field>
            <field name="notes">Government fees and initial deposits processed</field>
        </record>
        
        <record id="checkpoint_line_kyc" model="project.checkpoint.template.line">
            <field name="name">Complete KYC Process</field>
            <field name="sequence">40</field>
            <field name="template_id" ref="checkpoint_template_company_formation"/>
            <field name="auto_advance_stage">True</field>
            <field name="notes">Know Your Customer documentation completed</field>
        </record>
        
        <record id="checkpoint_line_approval" model="project.checkpoint.template.line">
            <field name="name">Final Approval</field>
            <field name="sequence">50</field>
            <field name="template_id" ref="checkpoint_template_company_formation"/>
            <field name="auto_advance_stage">True</field>
            <field name="notes">Final approval received from authorities</field>
        </record>
        
