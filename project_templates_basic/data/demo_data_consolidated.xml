        <!-- Compliance Project Templates -->
        <record id="demo_project_template_software_compliance" model="project.project">
            <field name="name">Software Company Compliance Template</field>
            <field name="description">Standard compliance template for software development companies</field>
            <field name="is_template">True</field>
            <field name="template_category">compliance_services</field>
            <field name="template_description">Comprehensive compliance template for software companies with multiple shareholders</field>
            <field name="estimated_duration">30</field>
            <field name="complexity_level">complex</field>
            <field name="compliance_requirements">Complete compliance setup for software development companies including shareholder management, UBO tracking, and regulatory compliance</field>
            <field name="shareholder_requirements">Individual and corporate shareholders with proper documentation and residency verification</field>
            <field name="ubo_requirements">Ultimate Beneficial Owner identification and verification for transparency</field>
            <field name="document_requirements">Passport copies, EID verification, Trade License, Memorandum of Association, and compliance certificates</field>
        </record>

