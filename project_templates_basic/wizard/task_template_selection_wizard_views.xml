<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Task Template Selection Wizard Form View -->
        <record id="view_task_template_selection_wizard_form" model="ir.ui.view">
            <field name="name">task.template.selection.wizard.form</field>
            <field name="model">task.template.selection.wizard</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <field name="task_id" readonly="1"/>
                            <field name="template_id" domain="[('active', '=', True), ('apply_to_tasks', '=', True)]"/>
                        </group>
                        
                        <!-- Template Preview Information -->
                        <group invisible="not template_id">
                            <group string="Template Information">
                                <field name="template_name" readonly="1"/>
                                <field name="template_type" readonly="1"/>
                                <field name="document_count" readonly="1"/>
                            </group>
                            <group>
                                <field name="checklist_count" readonly="1"/>
                                <field name="template_description" readonly="1"/>
                            </group>
                        </group>
                    </sheet>
                    <footer>
                        <button name="action_preview_template" 
                                type="object" 
                                string="Preview Template" 
                                class="btn-secondary"
                                invisible="not template_id"/>
                        <button name="action_apply_template" 
                                type="object" 
                                string="Apply Template" 
                                class="btn-primary"
                                invisible="not template_id"/>
                        <button string="Cancel" 
                                class="btn-secondary" 
                                special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>
    </data>
</odoo>
