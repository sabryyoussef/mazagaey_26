<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Demo Project Templates -->
        <record id="demo_project_template_1" model="project.project">
            <field name="name">Demo: Web Development Project Template</field>
            <field name="description">Standard template for web development projects</field>
            <field name="is_template">True</field>
            <field name="template_category">development</field>
            <field name="template_description">Complete web development project template with all phases</field>
        </record>

        <record id="demo_project_template_2" model="project.project">
            <field name="name">Demo: Mobile App Development Template</field>
            <field name="description">Template for mobile application development</field>
            <field name="is_template">True</field>
            <field name="template_category">mobile</field>
            <field name="template_description">Mobile app development template with UI/UX phases</field>
        </record>

        <!-- Demo Checkpoint Templates -->
        <record id="demo_checkpoint_template_1" model="project.checkpoint.template">
            <field name="name">Demo: Requirements Gathering</field>
            <field name="sequence">10</field>
            <field name="active">True</field>
            <field name="notes">Gather and document project requirements</field>
        </record>

        <record id="demo_checkpoint_template_2" model="project.checkpoint.template">
            <field name="name">Demo: Design Phase</field>
            <field name="sequence">20</field>
            <field name="active">True</field>
            <field name="notes">Create UI/UX designs and technical specifications</field>
        </record>

        <record id="demo_checkpoint_template_3" model="project.checkpoint.template">
            <field name="name">Demo: Development Phase</field>
            <field name="sequence">30</field>
            <field name="active">True</field>
            <field name="notes">Core development and coding phase</field>
        </record>

        <record id="demo_checkpoint_template_4" model="project.checkpoint.template">
            <field name="name">Demo: Testing Phase</field>
            <field name="sequence">40</field>
            <field name="active">True</field>
            <field name="notes">Quality assurance and testing</field>
        </record>

        <record id="demo_checkpoint_template_5" model="project.checkpoint.template">
            <field name="name">Demo: Deployment</field>
            <field name="sequence">50</field>
            <field name="active">True</field>
            <field name="notes">Production deployment and go-live</field>
        </record>

        <!-- Demo Document Templates -->
        <record id="demo_document_template_1" model="project.checkpoint.template">
            <field name="name">Demo: Project Charter</field>
            <field name="sequence">5</field>
            <field name="active">True</field>
            <field name="notes">Project charter document template</field>
        </record>

        <record id="demo_document_template_2" model="project.checkpoint.template">
            <field name="name">Demo: Technical Specification</field>
            <field name="sequence">15</field>
            <field name="active">True</field>
            <field name="notes">Technical specification document</field>
        </record>

        <!-- Demo Checkpoint Template Lines -->
        <record id="demo_checkpoint_template_line_1" model="project.checkpoint.template.line">
            <field name="template_id" ref="demo_project_template_1"/>
            <field name="checkpoint_template_id" ref="demo_checkpoint_template_1"/>
            <field name="sequence">10</field>
        </record>

        <record id="demo_checkpoint_template_line_2" model="project.checkpoint.template.line">
            <field name="template_id" ref="demo_project_template_1"/>
            <field name="checkpoint_template_id" ref="demo_checkpoint_template_2"/>
            <field name="sequence">20</field>
        </record>

        <record id="demo_checkpoint_template_line_3" model="project.checkpoint.template.line">
            <field name="template_id" ref="demo_project_template_1"/>
            <field name="checkpoint_template_id" ref="demo_checkpoint_template_3"/>
            <field name="sequence">30</field>
        </record>

        <record id="demo_checkpoint_template_line_4" model="project.checkpoint.template.line">
            <field name="template_id" ref="demo_project_template_1"/>
            <field name="checkpoint_template_id" ref="demo_checkpoint_template_4"/>
            <field name="sequence">40</field>
        </record>

        <record id="demo_checkpoint_template_line_5" model="project.checkpoint.template.line">
            <field name="template_id" ref="demo_project_template_1"/>
            <field name="checkpoint_template_id" ref="demo_checkpoint_template_5"/>
            <field name="sequence">50</field>
        </record>
    </data>
</odoo>
