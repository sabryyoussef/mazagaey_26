<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Return Compliance Wizard Form View -->
        <record id="view_return_compliance_wizard_form" model="ir.ui.view">
            <field name="name">return.compliance.wizard.form</field>
            <field name="model">return.compliance.wizard</field>
            <field name="arch" type="xml">
                <form string="Return Compliance">
                    <group>
                        <field name="project_id" readonly="1"/>
                        <field name="return_reason" placeholder="Please provide a reason for returning the compliance..."/>
                    </group>
                    <footer>
                        <button name="action_return_compliance" type="object" string="Return Compliance" class="btn btn-primary"/>
                        <button string="Cancel" class="btn btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <!-- Return Compliance Wizard Action -->
        <record id="action_return_compliance_wizard" model="ir.actions.act_window">
            <field name="name">Return Compliance</field>
            <field name="res_model">return.compliance.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>
    </data>
</odoo>
