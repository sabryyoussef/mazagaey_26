<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Inherit Product Form -->
        <record id="view_product_template_form_inherit_checkpoints" model="ir.ui.view">
            <field name="name">product.template.form.inherit.checkpoints</field>
            <field name="model">product.template</field>
            <field name="inherit_id" ref="product.product_template_form_view"/>
            <field name="arch" type="xml">
                <xpath expr="//page[@name='general_information']" position="after">
                    <page string="Checkpoint Templates" name="checkpoint_templates" 
                          invisible="type != 'service' or service_tracking not in ['task_in_project', 'project_only']">
                        <group>
                            <field name="auto_apply_checkpoint_templates"/>
                            <field name="checkpoint_template_ids" widget="many2many_tags"/>
                        </group>
                        <field name="checkpoint_template_ids">
                            <list>
                                <field name="name"/>
                                <field name="line_count"/>
                                <field name="rule_count"/>
                            </list>
                        </field>
                    </page>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
