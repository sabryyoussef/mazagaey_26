<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Inherit Task Form View -->
        <record id="view_task_form_inherit_checkpoints" model="ir.ui.view">
            <field name="name">project.task.form.inherit.checkpoints</field>
            <field name="model">project.task</field>
            <field name="inherit_id" ref="project.view_task_form2"/>
            <field name="arch" type="xml">
                <!-- Add smart buttons to header -->
                <xpath expr="//header" position="inside">
                    <button name="%(project_checkpoints_basic.action_project_task_checkpoint)d" 
                            type="action" 
                            string="Checkpoints" 
                            class="oe_stat_button"
                            icon="fa-flag-checkered"
                            invisible="checkpoint_count == 0">
                        <field name="checkpoint_count" widget="statinfo" string="Total"/>
                    </button>
                    <button name="%(project_checkpoints_basic.action_project_task_checkpoint)d" 
                            type="action" 
                            string="Completed" 
                            class="oe_stat_button"
                            icon="fa-check-circle"
                            invisible="completed_checkpoint_count == 0">
                        <field name="completed_checkpoint_count" widget="statinfo" string="Done"/>
                    </button>

                </xpath>
                
                <!-- Add progress bar to form -->
                <xpath expr="//sheet/group" position="after">
                    <group invisible="checkpoint_count == 0">
                        <field name="checkpoint_progress" widget="progressbar" string="Checkpoint Progress"/>
                    </group>
                </xpath>
                
                <!-- Add Checkpoints tab -->
                <xpath expr="//notebook" position="inside">
                    <page string="Checkpoints" name="checkpoints">
                        <field name="checkpoint_ids">
                            <list editable="bottom">
                                <field name="sequence" widget="handle"/>
                                <field name="name"/>
                                <field name="tag_ids" widget="many2many_tags"/>
                                <field name="is_reached"/>
                                <field name="auto_advance_stage"/>
                                <field name="target_stage_id"/>
                                <field name="notes"/>
                            </list>
                        </field>
                    </page>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
