<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- List View -->
        <record id="view_project_task_checkpoint_tag_list" model="ir.ui.view">
            <field name="name">project.task.checkpoint.tag.list</field>
            <field name="model">project.task.checkpoint.tag</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name"/>
                    <field name="color" widget="color_picker"/>
                </list>
            </field>
        </record>

        <!-- Form View -->
        <record id="view_project_task_checkpoint_tag_form" model="ir.ui.view">
            <field name="name">project.task.checkpoint.tag.form</field>
            <field name="model">project.task.checkpoint.tag</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <field name="name"/>
                            <field name="color" widget="color_picker"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Action -->
        <record id="action_project_task_checkpoint_tag" model="ir.actions.act_window">
            <field name="name">Checkpoint Tags</field>
            <field name="res_model">project.task.checkpoint.tag</field>
            <field name="view_mode">list,form</field>
        </record>

        <!-- Menu -->
        <menuitem id="menu_project_task_checkpoint_tag"
                  name="Checkpoint Tags"
                  parent="project.menu_project_config"
                  action="action_project_task_checkpoint_tag"
                  sequence="50"/>
    </data>
</odoo>
