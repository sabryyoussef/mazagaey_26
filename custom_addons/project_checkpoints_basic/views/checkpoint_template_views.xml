<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- List View -->
        <record id="view_project_task_checkpoint_template_list" model="ir.ui.view">
            <field name="name">project.task.checkpoint.template.list</field>
            <field name="model">project.task.checkpoint.template</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name"/>
                    <field name="sequence"/>
                    <field name="line_count"/>
                    <field name="rule_count"/>
                    <field name="create_milestone"/>
                    <field name="display_milestone_name"/>
                    <field name="active"/>
                </list>
            </field>
        </record>

        <!-- Form View -->
        <record id="view_project_task_checkpoint_template_form" model="ir.ui.view">
            <field name="name">project.task.checkpoint.template.form</field>
            <field name="model">project.task.checkpoint.template</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button name="toggle_active" type="object" class="oe_stat_button" icon="fa-archive">
                                <field name="active" widget="boolean_button"/>
                            </button>
                        </div>
                        <group>
                            <group>
                                <field name="name"/>
                                <field name="sequence"/>
                            </group>
                            <group>
                                <field name="line_count"/>
                                <field name="rule_count"/>
                            </group>
                        </group>
                        <!-- Milestone Configuration Section -->
                        <group invisible="not create_milestone">
                            <group>
                                <field name="create_milestone"/>
                                <field name="milestone_name" invisible="not create_milestone"/>
                                <field name="display_milestone_name" readonly="1" invisible="not create_milestone"/>
                            </group>
                            <group>
                                <field name="milestone_deadline" invisible="not create_milestone"/>
                                <field name="milestone_notes" invisible="not create_milestone"/>
                            </group>
                        </group>
                        <group invisible="create_milestone">
                            <field name="create_milestone"/>
                        </group>
                        <notebook>
                            <page string="Checkpoint Lines" name="lines">
                                <field name="line_ids">
                                    <list editable="bottom">
                                        <field name="sequence" widget="handle"/>
                                        <field name="name"/>
                                        <field name="tag_ids" widget="many2many_tags"/>
                                        <field name="auto_advance_stage"/>
                                        <field name="target_stage_id"/>
                                        <field name="notes"/>
                                    </list>
                                </field>
                            </page>
                            <page string="Rules" name="rules">
                                <field name="rule_ids">
                                    <list editable="bottom">
                                        <field name="sequence" widget="handle"/>
                                        <field name="name"/>
                                        <field name="condition_type"/>
                                        <field name="min_count"/>
                                        <field name="percentage"/>
                                        <field name="tag_ids" widget="many2many_tags"/>
                                        <field name="target_stage_id"/>
                                        <field name="active"/>
                                    </list>
                                </field>
                            </page>
                            <page string="Notes" name="notes">
                                <field name="notes"/>
                            </page>
                            <page string="Milestone Notes" name="milestone_notes" invisible="not create_milestone">
                                <field name="milestone_notes"/>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Action -->
        <record id="action_project_task_checkpoint_template" model="ir.actions.act_window">
            <field name="name">Checkpoint Templates</field>
            <field name="res_model">project.task.checkpoint.template</field>
            <field name="view_mode">list,form</field>
        </record>

        <!-- Menu -->
        <menuitem id="menu_project_task_checkpoint_template"
                  name="Checkpoint Templates"
                  parent="project.menu_project_config"
                  action="action_project_task_checkpoint_template"
                  sequence="51"/>
    </data>
</odoo>
