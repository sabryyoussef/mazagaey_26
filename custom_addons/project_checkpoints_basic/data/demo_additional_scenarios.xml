<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        
        <!-- ========================================
             ADDITIONAL UAE BUSINESS SCENARIOS
             ======================================== -->
        
        <!-- Corporate Tax Registration Project -->
        <record id="demo_project_corporate_tax" model="project.project">
            <field name="name">Corporate Tax Registration - ABC Trading LLC</field>
            <field name="partner_id" ref="base.res_partner_12"/>
            <field name="description">Register company for UAE Corporate Tax including compliance setup and documentation.</field>
            <field name="privacy_visibility">employees</field>
            <field name="date_start" eval="(DateTime.now() - timedelta(days=5)).strftime('%Y-%m-%d')"/>
            <field name="date" eval="(DateTime.now() + timedelta(days=25)).strftime('%Y-%m-%d')"/>
        </record>
        
        <!-- VAT Registration Project -->
        <record id="demo_project_vat_registration" model="project.project">
            <field name="name">VAT Registration - ABC Trading LLC</field>
            <field name="partner_id" ref="base.res_partner_12"/>
            <field name="description">Register company for UAE VAT including system setup and compliance training.</field>
            <field name="privacy_visibility">employees</field>
            <field name="date_start" eval="(DateTime.now() - timedelta(days=3)).strftime('%Y-%m-%d')"/>
            <field name="date" eval="(DateTime.now() + timedelta(days=20)).strftime('%Y-%m-%d')"/>
        </record>
        
        <!-- Office Setup Project -->
        <record id="demo_project_office_setup" model="project.project">
            <field name="name">Office Setup & Ejari Registration - ABC Trading LLC</field>
            <field name="partner_id" ref="base.res_partner_12"/>
            <field name="description">Complete office setup including Ejari registration, utilities, and compliance requirements.</field>
            <field name="privacy_visibility">employees</field>
            <field name="date_start" eval="(DateTime.now() - timedelta(days=10)).strftime('%Y-%m-%d')"/>
            <field name="date" eval="(DateTime.now() + timedelta(days=40)).strftime('%Y-%m-%d')"/>
        </record>
        
        <!-- ========================================
             ADDITIONAL MILESTONES
             ======================================== -->
        
        <!-- Corporate Tax Milestones -->
        <record id="demo_milestone_tax_assessment" model="project.milestone">
            <field name="name">Tax Assessment & Planning</field>
            <field name="project_id" ref="demo_project_corporate_tax"/>
            <field name="deadline" eval="(DateTime.now() + timedelta(days=10)).strftime('%Y-%m-%d')"/>
            <field name="is_reached" eval="False"/>
        </record>
        
        <record id="demo_milestone_tax_registration" model="project.milestone">
            <field name="name">FTA Registration & Compliance</field>
            <field name="project_id" ref="demo_project_corporate_tax"/>
            <field name="deadline" eval="(DateTime.now() + timedelta(days=25)).strftime('%Y-%m-%d')"/>
            <field name="is_reached" eval="False"/>
        </record>
        
        <!-- VAT Registration Milestones -->
        <record id="demo_milestone_vat_assessment" model="project.milestone">
            <field name="name">VAT Assessment & System Setup</field>
            <field name="project_id" ref="demo_project_vat_registration"/>
            <field name="deadline" eval="(DateTime.now() + timedelta(days=8)).strftime('%Y-%m-%d')"/>
            <field name="is_reached" eval="False"/>
        </record>
        
        <record id="demo_milestone_vat_compliance" model="project.milestone">
            <field name="name">VAT Compliance & Training</field>
            <field name="project_id" ref="demo_project_vat_registration"/>
            <field name="deadline" eval="(DateTime.now() + timedelta(days=20)).strftime('%Y-%m-%d')"/>
            <field name="is_reached" eval="False"/>
        </record>
        
        <!-- Office Setup Milestones -->
        <record id="demo_milestone_office_selection" model="project.milestone">
            <field name="name">Office Selection & Contract</field>
            <field name="project_id" ref="demo_project_office_setup"/>
            <field name="deadline" eval="(DateTime.now() + timedelta(days=15)).strftime('%Y-%m-%d')"/>
            <field name="is_reached" eval="False"/>
        </record>
        
        <record id="demo_milestone_ejari_registration" model="project.milestone">
            <field name="name">Ejari Registration & Utilities</field>
            <field name="project_id" ref="demo_project_office_setup"/>
            <field name="deadline" eval="(DateTime.now() + timedelta(days=30)).strftime('%Y-%m-%d')"/>
            <field name="is_reached" eval="False"/>
        </record>
        
        <record id="demo_milestone_office_handover" model="project.milestone">
            <field name="name">Office Handover & Compliance</field>
            <field name="project_id" ref="demo_project_office_setup"/>
            <field name="deadline" eval="(DateTime.now() + timedelta(days=40)).strftime('%Y-%m-%d')"/>
            <field name="is_reached" eval="False"/>
        </record>
        
        <!-- ========================================
             ADDITIONAL CHECKPOINT TAGS
             ======================================== -->
        
        <record id="demo_tag_tax_related" model="project.task.checkpoint.tag">
            <field name="name">Tax Related</field>
            <field name="color">8"/>
        </record>
        
        <record id="demo_tag_vat_related" model="project.task.checkpoint.tag">
            <field name="name">VAT Related</field>
            <field name="color">9"/>
        </record>
        
        <record id="demo_tag_office_setup" model="project.task.checkpoint.tag">
            <field name="name">Office Setup</field>
            <field name="color">10"/>
        </record>
        
        <record id="demo_tag_ejari" model="project.task.checkpoint.tag">
            <field name="name">Ejari Registration</field>
            <field name="color">11"/>
        </record>
        
        <record id="demo_tag_utilities" model="project.task.checkpoint.tag">
            <field name="name">Utilities Setup</field>
            <field name="color">12"/>
        </record>
        
        <!-- ========================================
             CORPORATE TAX CHECKPOINTS
             ======================================== -->
        
        <!-- Tax Assessment Checkpoints -->
        <record id="demo_checkpoint_tax_assessment_meeting" model="project.task.checkpoint">
            <field name="name">Conduct Tax Assessment Meeting</field>
            <field name="sequence">10</field>
            <field name="milestone_id" ref="demo_milestone_tax_assessment"/>
            <field name="tag_ids" eval="[(6, 0, [ref('demo_tag_tax_related'), ref('demo_tag_partner_related')])]"/>
            <field name="is_reached" eval="False"/>
            <field name="notes">Meet with client to assess tax obligations, revenue streams, and compliance requirements.</field>
        </record>
        
        <record id="demo_checkpoint_financial_documents" model="project.task.checkpoint">
            <field name="name">Collect Financial Documents</field>
            <field name="sequence">20</field>
            <field name="milestone_id" ref="demo_milestone_tax_assessment"/>
            <field name="tag_ids" eval="[(6, 0, [ref('demo_tag_required_document'), ref('demo_tag_attachment'), ref('demo_tag_tax_related')])]"/>
            <field name="is_reached" eval="False"/>
            <field name="notes">Collect bank statements, financial records, and revenue documentation for tax assessment.</field>
        </record>
        
        <record id="demo_checkpoint_tax_planning" model="project.task.checkpoint">
            <field name="name">Develop Tax Planning Strategy</field>
            <field name="sequence">30</field>
            <field name="milestone_id" ref="demo_milestone_tax_assessment"/>
            <field name="tag_ids" eval="[(6, 0, [ref('demo_tag_tax_related'), ref('demo_tag_deliverable')])]"/>
            <field name="is_reached" eval="False"/>
            <field name="notes">Develop comprehensive tax planning strategy including compliance calendar and reporting requirements.</field>
        </record>
        
        <!-- Tax Registration Checkpoints -->
        <record id="demo_checkpoint_fta_registration" model="project.task.checkpoint">
            <field name="name">Register with Federal Tax Authority</field>
            <field name="sequence">40</field>
            <field name="milestone_id" ref="demo_milestone_tax_registration"/>
            <field name="tag_ids" eval="[(6, 0, [ref('demo_tag_government_approval'), ref('demo_tag_tax_related'), ref('demo_tag_compliance')])]"/>
            <field name="is_reached" eval="False"/>
            <field name="notes">Complete FTA registration for corporate tax. Submit all required documents and obtain TRN.</field>
        </record>
        
        <record id="demo_checkpoint_tax_system_setup" model="project.task.checkpoint">
            <field name="name">Setup Tax Accounting System</field>
            <field name="sequence">50</field>
            <field name="milestone_id" ref="demo_milestone_tax_registration"/>
            <field name="tag_ids" eval="[(6, 0, [ref('demo_tag_tax_related'), ref('demo_tag_deliverable')])]"/>
            <field name="is_reached" eval="False"/>
            <field name="notes">Setup accounting system for tax compliance including chart of accounts and reporting templates.</field>
        </record>
        
        <record id="demo_checkpoint_tax_training" model="project.task.checkpoint">
            <field name="name">Conduct Tax Compliance Training</field>
            <field name="sequence">60</field>
            <field name="milestone_id" ref="demo_milestone_tax_registration"/>
            <field name="tag_ids" eval="[(6, 0, [ref('demo_tag_tax_related'), ref('demo_tag_handover')])]"/>
            <field name="is_reached" eval="False"/>
            <field name="notes">Train client team on tax compliance requirements, reporting deadlines, and documentation standards.</field>
        </record>
        
        <!-- ========================================
             VAT REGISTRATION CHECKPOINTS
             ======================================== -->
        
        <!-- VAT Assessment Checkpoints -->
        <record id="demo_checkpoint_vat_assessment" model="project.task.checkpoint">
            <field name="name">Conduct VAT Assessment</field>
            <field name="sequence">10</field>
            <field name="milestone_id" ref="demo_milestone_vat_assessment"/>
            <field name="tag_ids" eval="[(6, 0, [ref('demo_tag_vat_related'), ref('demo_tag_partner_related')])]"/>
            <field name="is_reached" eval="False"/>
            <field name="notes">Assess VAT obligations, revenue thresholds, and registration requirements.</field>
        </record>
        
        <record id="demo_checkpoint_vat_documents" model="project.task.checkpoint">
            <field name="name">Collect VAT Registration Documents</field>
            <field name="sequence">20</field>
            <field name="milestone_id" ref="demo_milestone_vat_assessment"/>
            <field name="tag_ids" eval="[(6, 0, [ref('demo_tag_required_document'), ref('demo_tag_attachment'), ref('demo_tag_vat_related')])]"/>
            <field name="is_reached" eval="False"/>
            <field name="notes">Collect trade license, passport copies, bank statements, and business plan for VAT registration.</field>
        </record>
        
        <record id="demo_checkpoint_vat_system_setup" model="project.task.checkpoint">
            <field name="name">Setup VAT Accounting System</field>
            <field name="sequence">30</field>
            <field name="milestone_id" ref="demo_milestone_vat_assessment"/>
            <field name="tag_ids" eval="[(6, 0, [ref('demo_tag_vat_related'), ref('demo_tag_deliverable')])]"/>
            <field name="is_reached" eval="False"/>
            <field name="notes">Setup accounting system for VAT including tax codes, reporting templates, and compliance tracking.</field>
        </record>
        
        <!-- VAT Compliance Checkpoints -->
        <record id="demo_checkpoint_vat_registration" model="project.task.checkpoint">
            <field name="name">Submit VAT Registration</field>
            <field name="sequence">40</field>
            <field name="milestone_id" ref="demo_milestone_vat_compliance"/>
            <field name="tag_ids" eval="[(6, 0, [ref('demo_tag_government_approval'), ref('demo_tag_vat_related'), ref('demo_tag_compliance')])]"/>
            <field name="is_reached" eval="False"/>
            <field name="notes">Submit VAT registration application to FTA. Track application status and respond to queries.</field>
        </record>
        
        <record id="demo_checkpoint_vat_training" model="project.task.checkpoint">
            <field name="name">Conduct VAT Training</field>
            <field name="sequence">50</field>
            <field name="milestone_id" ref="demo_milestone_vat_compliance"/>
            <field name="tag_ids" eval="[(6, 0, [ref('demo_tag_vat_related'), ref('demo_tag_handover')])]"/>
            <field name="is_reached" eval="False"/>
            <field name="notes">Train client team on VAT compliance, invoicing requirements, and return filing procedures.</field>
        </record>
        
        <!-- ========================================
             OFFICE SETUP CHECKPOINTS
             ======================================== -->
        
        <!-- Office Selection Checkpoints -->
        <record id="demo_checkpoint_office_requirements" model="project.task.checkpoint">
            <field name="name">Define Office Requirements</field>
            <field name="sequence">10</field>
            <field name="milestone_id" ref="demo_milestone_office_selection"/>
            <field name="tag_ids" eval="[(6, 0, [ref('demo_tag_office_setup'), ref('demo_tag_partner_related')])]"/>
            <field name="is_reached" eval="False"/>
            <field name="notes">Define office requirements including size, location, facilities, and budget constraints.</field>
        </record>
        
        <record id="demo_checkpoint_office_viewing" model="project.task.checkpoint">
            <field name="name">Arrange Office Viewings</field>
            <field name="sequence">20</field>
            <field name="milestone_id" ref="demo_milestone_office_selection"/>
            <field name="tag_ids" eval="[(6, 0, [ref('demo_tag_office_setup'), ref('demo_tag_partner_related')])]"/>
            <field name="is_reached" eval="False"/>
            <field name="notes">Arrange viewings of suitable office spaces. Coordinate with client for site visits.</field>
        </record>
        
        <record id="demo_checkpoint_office_contract" model="project.task.checkpoint">
            <field name="name">Negotiate & Sign Office Contract</field>
            <field name="sequence">30</field>
            <field name="milestone_id" ref="demo_milestone_office_selection"/>
            <field name="tag_ids" eval="[(6, 0, [ref('demo_tag_office_setup'), ref('demo_tag_required_document'), ref('demo_tag_attachment')])]"/>
            <field name="is_reached" eval="False"/>
            <field name="notes">Negotiate lease terms and sign office contract. Ensure compliance with DED requirements.</field>
        </record>
        
        <!-- Ejari Registration Checkpoints -->
        <record id="demo_checkpoint_ejari_documents" model="project.task.checkpoint">
            <field name="name">Collect Ejari Registration Documents</field>
            <field name="sequence">40</field>
            <field name="milestone_id" ref="demo_milestone_ejari_registration"/>
            <field name="tag_ids" eval="[(6, 0, [ref('demo_tag_ejari'), ref('demo_tag_required_document'), ref('demo_tag_attachment')])]"/>
            <field name="is_reached" eval="False"/>
            <field name="notes">Collect lease contract, landlord documents, and company documents for Ejari registration.</field>
        </record>
        
        <record id="demo_checkpoint_ejari_registration" model="project.task.checkpoint">
            <field name="name">Complete Ejari Registration</field>
            <field name="sequence">50</field>
            <field name="milestone_id" ref="demo_milestone_ejari_registration"/>
            <field name="tag_ids" eval="[(6, 0, [ref('demo_tag_ejari'), ref('demo_tag_government_approval'), ref('demo_tag_compliance')])]"/>
            <field name="is_reached" eval="False"/>
            <field name="notes">Submit Ejari registration application and obtain registration certificate.</field>
        </record>
        
        <record id="demo_checkpoint_utilities_setup" model="project.task.checkpoint">
            <field name="name">Setup Utilities & Services</field>
            <field name="sequence">60</field>
            <field name="milestone_id" ref="demo_milestone_ejari_registration"/>
            <field name="tag_ids" eval="[(6, 0, [ref('demo_tag_utilities'), ref('demo_tag_office_setup')])]"/>
            <field name="is_reached" eval="False"/>
            <field name="notes">Setup electricity, water, internet, and other essential utilities for the office.</field>
        </record>
        
        <!-- Office Handover Checkpoints -->
        <record id="demo_checkpoint_office_inspection" model="project.task.checkpoint">
            <field name="name">Conduct Final Office Inspection</field>
            <field name="sequence">70</field>
            <field name="milestone_id" ref="demo_milestone_office_handover"/>
            <field name="tag_ids" eval="[(6, 0, [ref('demo_tag_office_setup'), ref('demo_tag_compliance')])]"/>
            <field name="is_reached" eval="False"/>
            <field name="notes">Conduct final inspection to ensure office meets all requirements and compliance standards.</field>
        </record>
        
        <record id="demo_checkpoint_office_handover" model="project.task.checkpoint">
            <field name="name">Complete Office Handover</field>
            <field name="sequence">80</field>
            <field name="milestone_id" ref="demo_milestone_office_handover"/>
            <field name="tag_ids" eval="[(6, 0, [ref('demo_tag_handover'), ref('demo_tag_office_setup'), ref('demo_tag_deliverable')])]"/>
            <field name="is_reached" eval="False"/>
            <field name="notes">Complete office handover including all keys, access cards, and compliance documentation.</field>
        </record>
        
        <!-- ========================================
             ADDITIONAL TEMPLATES
             ======================================== -->
        
        <!-- Corporate Tax Template -->
        <record id="demo_milestone_template_corporate_tax" model="project.milestone.template">
            <field name="name">UAE Corporate Tax Registration - Complete Process</field>
            <field name="sequence">40</field>
            <field name="milestone_name">Tax Assessment & Planning</field>
            <field name="milestone_deadline" eval="(DateTime.now() + timedelta(days=10)).strftime('%Y-%m-%d')"/>
            <field name="notes">Complete template for UAE corporate tax registration including assessment, planning, and compliance setup.</field>
        </record>
        
        <!-- VAT Registration Template -->
        <record id="demo_milestone_template_vat_registration" model="project.milestone.template">
            <field name="name">UAE VAT Registration - Standard Package</field>
            <field name="sequence">50</field>
            <field name="milestone_name">VAT Assessment & System Setup</field>
            <field name="milestone_deadline" eval="(DateTime.now() + timedelta(days=8)).strftime('%Y-%m-%d')"/>
            <field name="notes">Standard template for UAE VAT registration including assessment, system setup, and compliance training.</field>
        </record>
        
        <!-- Office Setup Template -->
        <record id="demo_milestone_template_office_setup" model="project.milestone.template">
            <field name="name">UAE Office Setup - Complete Process</field>
            <field name="sequence">60</field>
            <field name="milestone_name">Office Selection & Contract</field>
            <field name="milestone_deadline" eval="(DateTime.now() + timedelta(days=15)).strftime('%Y-%m-%d')"/>
            <field name="notes">Complete template for UAE office setup including selection, Ejari registration, and utilities setup.</field>
        </record>
        
        <!-- ========================================
             ADDITIONAL TASKS
             ======================================== -->
        
        <!-- Corporate Tax Task -->
        <record id="demo_task_corporate_tax" model="project.task">
            <field name="name">Complete Corporate Tax Registration</field>
            <field name="project_id" ref="demo_project_corporate_tax"/>
            <field name="description">Manage complete corporate tax registration process including assessment, planning, and compliance setup.</field>
            <field name="priority">1"/>
            <field name="date_deadline" eval="(DateTime.now() + timedelta(days=25)).strftime('%Y-%m-%d')"/>
        </record>
        
        <!-- VAT Registration Task -->
        <record id="demo_task_vat_registration" model="project.task">
            <field name="name">Complete VAT Registration</field>
            <field name="project_id" ref="demo_project_vat_registration"/>
            <field name="description">Manage complete VAT registration process including assessment, system setup, and compliance training.</field>
            <field name="priority">1"/>
            <field name="date_deadline" eval="(DateTime.now() + timedelta(days=20)).strftime('%Y-%m-%d')"/>
        </record>
        
        <!-- Office Setup Task -->
        <record id="demo_task_office_setup" model="project.task">
            <field name="name">Complete Office Setup</field>
            <field name="project_id" ref="demo_project_office_setup"/>
            <field name="description">Manage complete office setup process including selection, Ejari registration, utilities, and handover.</field>
            <field name="priority">1"/>
            <field name="date_deadline" eval="(DateTime.now() + timedelta(days=40)).strftime('%Y-%m-%d')"/>
        </record>
        
    </data>
</odoo>
