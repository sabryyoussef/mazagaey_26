<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Demo Task Stages -->
        <record id="demo_stage_planning" model="project.task.type">
            <field name="name">Planning</field>
            <field name="sequence">10</field>
        </record>

        <record id="demo_stage_development" model="project.task.type">
            <field name="name">Development</field>
            <field name="sequence">20</field>
        </record>

        <record id="demo_stage_testing" model="project.task.type">
            <field name="name">Testing</field>
            <field name="sequence">30</field>
        </record>

        <record id="demo_stage_review" model="project.task.type">
            <field name="name">Review</field>
            <field name="sequence">40</field>
        </record>

        <record id="demo_stage_deployment" model="project.task.type">
            <field name="name">Deployment</field>
            <field name="sequence">50</field>
        </record>

        <record id="demo_stage_completed" model="project.task.type">
            <field name="name">Completed</field>
            <field name="sequence">60</field>
        </record>

        <!-- Demo Checkpoints -->
        <record id="demo_checkpoint_requirements" model="project.task.checkpoint">
            <field name="name">Requirements Analysis</field>
            <field name="sequence">10</field>
            <field name="auto_advance_stage">True</field>
            <field name="target_stage_id" ref="demo_stage_planning"/>
            <field name="notes">Complete requirements gathering and analysis</field>
        </record>

        <record id="demo_checkpoint_design" model="project.task.checkpoint">
            <field name="name">System Design</field>
            <field name="sequence">20</field>
            <field name="auto_advance_stage">True</field>
            <field name="target_stage_id" ref="demo_stage_planning"/>
            <field name="notes">Create system architecture and design documents</field>
        </record>

        <record id="demo_checkpoint_coding" model="project.task.checkpoint">
            <field name="name">Core Development</field>
            <field name="sequence">30</field>
            <field name="auto_advance_stage">True</field>
            <field name="target_stage_id" ref="demo_stage_development"/>
            <field name="notes">Implement core functionality</field>
        </record>

        <record id="demo_checkpoint_unit_tests" model="project.task.checkpoint">
            <field name="name">Unit Tests</field>
            <field name="sequence">40</field>
            <field name="auto_advance_stage">True</field>
            <field name="target_stage_id" ref="demo_stage_development"/>
            <field name="notes">Write and execute unit tests</field>
        </record>

        <record id="demo_checkpoint_integration" model="project.task.checkpoint">
            <field name="name">Integration Testing</field>
            <field name="sequence">50</field>
            <field name="auto_advance_stage">True</field>
            <field name="target_stage_id" ref="demo_stage_testing"/>
            <field name="notes">Perform integration testing</field>
        </record>

        <record id="demo_checkpoint_code_review" model="project.task.checkpoint">
            <field name="name">Code Review</field>
            <field name="sequence">60</field>
            <field name="auto_advance_stage">True</field>
            <field name="target_stage_id" ref="demo_stage_review"/>
            <field name="notes">Complete peer code review</field>
        </record>

        <record id="demo_checkpoint_deployment" model="project.task.checkpoint">
            <field name="name">Deploy to Staging</field>
            <field name="sequence">70</field>
            <field name="auto_advance_stage">True</field>
            <field name="target_stage_id" ref="demo_stage_deployment"/>
            <field name="notes">Deploy to staging environment</field>
        </record>

        <record id="demo_checkpoint_production" model="project.task.checkpoint">
            <field name="name">Production Deployment</field>
            <field name="sequence">80</field>
            <field name="auto_advance_stage">True</field>
            <field name="target_stage_id" ref="demo_stage_deployment"/>
            <field name="notes">Deploy to production environment</field>
        </record>

        <record id="demo_checkpoint_documentation" model="project.task.checkpoint">
            <field name="name">Documentation</field>
            <field name="sequence">90</field>
            <field name="auto_advance_stage">False</field>
            <field name="notes">Update documentation and user guides</field>
        </record>

        <record id="demo_checkpoint_final_testing" model="project.task.checkpoint">
            <field name="name">Final Testing</field>
            <field name="sequence">100</field>
            <field name="auto_advance_stage">True</field>
            <field name="target_stage_id" ref="demo_stage_completed"/>
            <field name="notes">Final testing and validation</field>
        </record>
    </data>
</odoo>
