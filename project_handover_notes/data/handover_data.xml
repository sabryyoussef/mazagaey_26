<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Sequence for Handover Notes -->
        <record id="seq_project_handover_notes" model="ir.sequence">
            <field name="name">Project Handover Notes</field>
            <field name="code">project.handover.notes</field>
            <field name="prefix">HOV</field>
            <field name="padding">5</field>
            <field name="number_increment">1</field>
        </record>

        <!-- Demo License Activities -->
        <record id="license_activity_trading" model="license.activity">
            <field name="name">Trading</field>
            <field name="code">TRD</field>
            <field name="description">General trading activities including import/export</field>
            <field name="sequence">10</field>
        </record>

        <record id="license_activity_consulting" model="license.activity">
            <field name="name">Consulting</field>
            <field name="code">CON</field>
            <field name="description">Business consulting and advisory services</field>
            <field name="sequence">20</field>
        </record>

        <record id="license_activity_technology" model="license.activity">
            <field name="name">Technology Services</field>
            <field name="code">TECH</field>
            <field name="description">IT and technology consulting services</field>
            <field name="sequence">30</field>
        </record>

        <record id="license_activity_manufacturing" model="license.activity">
            <field name="name">Manufacturing</field>
            <field name="code">MFG</field>
            <field name="description">Manufacturing and production activities</field>
            <field name="sequence">40</field>
        </record>

        <record id="license_activity_services" model="license.activity">
            <field name="name">Professional Services</field>
            <field name="code">PRO</field>
            <field name="description">Professional services including legal, accounting, etc.</field>
            <field name="sequence">50</field>
        </record>

        <record id="license_activity_retail" model="license.activity">
            <field name="name">Retail</field>
            <field name="code">RET</field>
            <field name="description">Retail and consumer goods sales</field>
            <field name="sequence">60</field>
        </record>

        <record id="license_activity_construction" model="license.activity">
            <field name="name">Construction</field>
            <field name="code">CONS</field>
            <field name="description">Construction and real estate development</field>
            <field name="sequence">70</field>
        </record>

        <record id="license_activity_healthcare" model="license.activity">
            <field name="name">Healthcare</field>
            <field name="code">HLTH</field>
            <field name="description">Healthcare and medical services</field>
            <field name="sequence">80</field>
        </record>
    </data>
</odoo>
