<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Handover Summary Wizard Form View -->
        <record id="view_handover_summary_wizard_form" model="ir.ui.view">
            <field name="name">handover.summary.wizard.form</field>
            <field name="model">handover.summary.wizard</field>
            <field name="arch" type="xml">
                <form string="Handover Summary">
                    <group>
                        <field name="project_id"/>
                        <field name="report_type" widget="radio" options="{'horizontal': true}"/>
                    </group>
                    <field name="handover_ids" readonly="1">
                        <list>
                            <field name="name"/>
                            <field name="hand_partner_id"/>
                            <field name="handover_status"/>
                            <field name="handover_date"/>
                            <field name="handover_by"/>
                        </list>
                    </field>
                    <footer>
                        <button name="action_generate_report" type="object" string="Generate Report" class="btn btn-primary"/>
                        <button string="Cancel" class="btn btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <!-- Handover Summary Wizard Action -->
        <record id="action_handover_summary_wizard" model="ir.actions.act_window">
            <field name="name">Handover Summary</field>
            <field name="res_model">handover.summary.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>
    </data>
</odoo>
