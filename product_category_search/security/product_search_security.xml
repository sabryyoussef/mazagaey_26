<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        
        <!-- Product Search Security Groups -->
        <record id="group_product_search_user" model="res.groups">
            <field name="name">Product Search User</field>
            <field name="category_id" ref="base.module_category_sales_sales"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>
        
        <record id="group_product_search_manager" model="res.groups">
            <field name="name">Product Search Manager</field>
            <field name="category_id" ref="base.module_category_sales_sales"/>
            <field name="implied_ids" eval="[(4, ref('group_product_search_user')), (4, ref('sales_team.group_sale_manager'))]"/>
        </record>
        
        <!-- Record Rules for Search Presets -->
        <record id="product_search_preset_personal_rule" model="ir.rule">
            <field name="name">Personal Search Presets</field>
            <field name="model_id" ref="model_product_search_preset"/>
            <field name="domain_force">[('is_public', '=', True), ('user_id', '=', user.id)]</field>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="1"/>
        </record>
        
        <record id="product_search_preset_public_rule" model="ir.rule">
            <field name="name">Public Search Presets</field>
            <field name="model_id" ref="model_product_search_preset"/>
            <field name="domain_force">[('is_public', '=', True)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="0"/>
            <field name="perm_create" eval="0"/>
            <field name="perm_unlink" eval="0"/>
        </record>
        
    </data>
</odoo>
