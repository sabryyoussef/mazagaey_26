<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        
        <!-- Department Master Data from Freezoner Analysis -->
        
        <!-- Accounts Department -->
        <record id="department_accounts" model="product.department">
            <field name="name">Accounts</field>
            <field name="code">ACCT</field>
            <field name="description">Accounting department responsible for financial tracking, tax compliance, audit reports, and financial workflow management</field>
            <field name="color">5</field>
            <field name="sequence">10</field>
        </record>
        
        <!-- Operations Department -->
        <record id="department_operations" model="product.department">
            <field name="name">Operations</field>
            <field name="code">OPS</field>
            <field name="description">Operations team responsible for service execution, document processing, license applications, visa processing, and customer service delivery</field>
            <field name="color">3</field>
            <field name="sequence">20</field>
        </record>
        
        <!-- Sales Department -->
        <record id="department_sales" model="product.department">
            <field name="name">Sales</field>
            <field name="code">SALES</field>
            <field name="description">Sales team responsible for client acquisition, quotations, business development, and customer-facing activities</field>
            <field name="color">1</field>
            <field name="sequence">30</field>
        </record>
        
        <!-- Admin Department (for Business Administration Services) -->
        <record id="department_admin" model="product.department">
            <field name="name">Administration</field>
            <field name="code">ADMIN</field>
            <field name="description">Administrative team responsible for company amendments, ownership changes, license modifications, and general administrative tasks</field>
            <field name="color">9</field>
            <field name="sequence">40</field>
        </record>
        
    </data>
</odoo>
