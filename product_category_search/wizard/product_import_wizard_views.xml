<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        
        <!-- Product Import Wizard Form View -->
        <record id="view_product_import_wizard_form" model="ir.ui.view">
            <field name="name">product.import.wizard.form</field>
            <field name="model">product.import.wizard</field>
            <field name="arch" type="xml">
                <form string="Import Products from CSV">
                    <header>
                        <field name="state" widget="statusbar" 
                               statusbar_visible="upload,mapping,preview,import"/>
                    </header>
                    
                    <!-- STEP 1: Upload File -->
                    <div invisible="state != 'upload'">
                        <div class="alert alert-info" role="alert">
                            <strong>Step 1: Upload CSV File</strong>
                            <p>Upload a CSV file containing your product data. The wizard will auto-detect columns and map them to product fields.</p>
                        </div>
                        
                        <group>
                            <group string="Import Settings">
                                <field name="name"/>
                                <field name="file_data" filename="file_name"/>
                                <field name="file_name" invisible="1"/>
                            </group>
                            <group string="File Format">
                                <field name="delimiter"/>
                                <field name="encoding"/>
                                <field name="has_header"/>
                            </group>
                        </group>
                        
                        <group string="Default Categorization">
                            <group>
                                <field name="product_type"/>
                                <field name="auto_detect_service_type"/>
                                <field name="auto_detect_department"/>
                            </group>
                            <group>
                                <field name="default_service_type_id"/>
                                <field name="default_department_id"/>
                                <field name="duplicate_action"/>
                            </group>
                        </group>
                        
                        <div class="alert alert-secondary">
                            <h5>Expected CSV Format:</h5>
                            <code>Name,Reference,Price,Category</code><br/>
                            <code>Employment Visa - 2 Years,EV2Y,2500,Visa Services</code><br/>
                            <code>Corporate Tax Registration,CTR,1000,Accounting</code>
                        </div>
                    </div>
                    
                    <!-- STEP 2: Column Mapping -->
                    <div invisible="state != 'mapping'">
                        <div class="alert alert-info" role="alert">
                            <strong>Step 2: Map Columns</strong>
                            <p>Review auto-detected mappings and adjust as needed. The "Name" column is required.</p>
                        </div>
                        
                        <group>
                            <field name="row_count" string="Total Data Rows"/>
                        </group>
                        
                        <field name="column_mapping_ids" nolabel="1">
                            <list editable="bottom">
                                <field name="column_index" readonly="1"/>
                                <field name="column_name" readonly="1"/>
                                <field name="field_name"/>
                                <field name="is_mapped" invisible="1"/>
                            </list>
                        </field>
                        
                        <div class="alert alert-warning mt-3">
                            <strong>Field Mapping Guide:</strong>
                            <ul class="mb-0">
                                <li><strong>Product Name</strong> - Required. The main product/service name</li>
                                <li><strong>Internal Reference</strong> - Optional SKU/code for quick lookup</li>
                                <li><strong>Sale Price</strong> - Product price (numbers only, currency symbols removed)</li>
                                <li><strong>Category</strong> - Used for auto-detection of service type</li>
                                <li><strong>Do Not Import</strong> - Skip this column</li>
                            </ul>
                        </div>
                    </div>
                    
                    <!-- STEP 3: Preview Data -->
                    <div invisible="state != 'preview'">
                        <div class="alert alert-info" role="alert">
                            <strong>Step 3: Preview Import</strong>
                            <p>Review the first <field name="preview_limit" class="d-inline"/> rows before importing. Service types and departments are auto-detected.</p>
                        </div>
                        
                        <field name="preview_line_ids" nolabel="1">
                            <list editable="bottom" decoration-success="status == 'new'" 
                                  decoration-warning="status == 'duplicate'"
                                  decoration-danger="status == 'error'">
                                <field name="row_number"/>
                                <field name="name"/>
                                <field name="default_code"/>
                                <field name="list_price"/>
                                <field name="category_name"/>
                                <field name="detected_service_type_id"/>
                                <field name="detected_department_id"/>
                                <field name="status" widget="badge" 
                                       decoration-success="status == 'new'"
                                       decoration-warning="status == 'duplicate'"
                                       decoration-danger="status == 'error'"/>
                                <field name="existing_product_id" optional="hide"/>
                                <field name="include" widget="boolean_toggle"/>
                            </list>
                        </field>
                        
                        <div class="row mt-3">
                            <div class="col-md-4">
                                <div class="alert alert-success">
                                    <strong>New Products:</strong> Will be created
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="alert alert-warning">
                                    <strong>Duplicates:</strong> Handled per your settings
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="alert alert-danger">
                                    <strong>Errors:</strong> Will be skipped
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <!-- STEP 4: Import Results -->
                    <div invisible="state != 'import'">
                        <div class="alert alert-success" role="alert">
                            <strong>Import Complete!</strong>
                        </div>
                        
                        <group>
                            <group string="Results Summary">
                                <field name="imported_count" class="text-success"/>
                                <field name="updated_count" class="text-primary"/>
                                <field name="error_count" class="text-danger"/>
                            </group>
                        </group>
                        
                        <group string="Import Log">
                            <field name="import_log" nolabel="1" readonly="1" 
                                   widget="text" class="o_text_overflow"/>
                        </group>
                    </div>
                    
                    <footer>
                        <!-- Upload Step Buttons -->
                        <button string="Analyze File" 
                                name="action_analyze_file" 
                                type="object" 
                                class="btn-primary"
                                invisible="state != 'upload'"/>
                        
                        <!-- Mapping Step Buttons -->
                        <button string="Back" 
                                name="action_back_to_upload" 
                                type="object"
                                invisible="state != 'mapping'"/>
                        <button string="Preview Import" 
                                name="action_generate_preview" 
                                type="object" 
                                class="btn-primary"
                                invisible="state != 'mapping'"/>
                        
                        <!-- Preview Step Buttons -->
                        <button string="Back" 
                                name="action_back_to_mapping" 
                                type="object"
                                invisible="state != 'preview'"/>
                        <button string="Execute Import" 
                                name="action_execute_import" 
                                type="object" 
                                class="btn-primary"
                                invisible="state != 'preview'"
                                confirm="This will create/update products. Continue?"/>
                        
                        <!-- Results Step Buttons -->
                        <button string="Import Another File" 
                                name="action_back_to_upload" 
                                type="object"
                                invisible="state != 'import'"/>
                        <button string="View Imported Products" 
                                name="action_view_imported_products" 
                                type="object" 
                                class="btn-primary"
                                invisible="state != 'import'"/>
                        
                        <button string="Close" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>
        
        <!-- Action to Open Import Wizard -->
        <record id="action_product_import_wizard" model="ir.actions.act_window">
            <field name="name">Import Products from CSV</field>
            <field name="res_model">product.import.wizard</field>
            <field name="view_mode">form</field>
            <field name="view_id" ref="view_product_import_wizard_form"/>
            <field name="target">new</field>
        </record>
        
    </data>
</odoo>
