<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        
        <!-- Service Type List View -->
        <record id="view_product_service_type_tree" model="ir.ui.view">
            <field name="name">product.service.type.tree</field>
            <field name="model">product.service.type</field>
            <field name="arch" type="xml">
                <list>
                    <field name="sequence" widget="handle"/>
                    <field name="code"/>
                    <field name="name"/>
                    <field name="parent_id"/>
                    <field name="product_count"/>
                </list>
            </field>
        </record>
        
        <!-- Service Type Form View -->
        <record id="view_product_service_type_form" model="ir.ui.view">
            <field name="name">product.service.type.form</field>
            <field name="model">product.service.type</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <group>
                                <field name="name"/>
                                <field name="code"/>
                                <field name="parent_id"/>
                            </group>
                            <group>
                                <field name="icon"/>
                                <field name="color"/>
                                <field name="sequence"/>
                                <field name="active"/>
                            </group>
                        </group>
                        <field name="description"/>
                    </sheet>
                </form>
            </field>
        </record>
        
        <!-- Service Type Action -->
        <record id="action_product_service_type" model="ir.actions.act_window">
            <field name="name">Service Types</field>
            <field name="res_model">product.service.type</field>
            <field name="view_mode">list,form</field>
        </record>
        
    </data>
</odoo>
