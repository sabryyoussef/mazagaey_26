<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Security Groups -->
        <record id="group_employee_accountability_user" model="res.groups">
            <field name="name">Employee Accountability User</field>
            <field name="category_id" ref="base.module_category_human_resources"/>
            <field name="comment">Users can view and use employee accountability features</field>
        </record>

        <record id="group_employee_accountability_manager" model="res.groups">
            <field name="name">Employee Accountability Manager</field>
            <field name="category_id" ref="base.module_category_human_resources"/>
            <field name="implied_ids" eval="[(4, ref('group_employee_accountability_user'))]"/>
            <field name="comment">Managers can manage employee codes and view all accountability data</field>
        </record>

        <!-- Model Definitions -->
        <record id="model_employee_session_context" model="ir.model">
            <field name="name">employee.session.context</field>
            <field name="model">employee.session.context</field>
        </record>

        <record id="model_employee_code_wizard" model="ir.model">
            <field name="name">employee.code.wizard</field>
            <field name="model">employee.code.wizard</field>
        </record>

        <!-- Record Rules -->
        <record id="rule_employee_session_context_user" model="ir.rule">
            <field name="name">Employee Session: User Access</field>
            <field name="model_id" ref="model_employee_session_context"/>
            <field name="domain_force">[
                '|',
                ('user_id', '=', user.id),
                ('employee_id.parent_user_id', '=', user.id)
            ]</field>
            <field name="groups" eval="[(4, ref('group_employee_accountability_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>
    </data>
</odoo>
