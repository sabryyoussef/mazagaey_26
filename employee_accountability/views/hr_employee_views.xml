<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Extend employee form view -->
        <record id="view_employee_form_accountability" model="ir.ui.view">
            <field name="name">hr.employee.form.accountability</field>
            <field name="model">hr.employee</field>
            <field name="inherit_id" ref="hr.view_employee_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='work_contact_id']" position="after">
                    <field name="employee_code"/>
                    <field name="parent_user_id"/>
                    <field name="employee_tag_ids" widget="many2many_tags"/>
                    <field name="current_session_id" readonly="1"/>
                </xpath>
                
                <!-- Add KPI smart button -->
                <xpath expr="//div[@name='button_box']" position="inside">
                    <button name="action_view_kpis"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-bar-chart">
                        <field name="total_tasks" widget="statinfo" string="Tasks"/>
                    </button>
                    <button name="action_view_timesheets"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-clock-o">
                        <field name="total_hours" widget="statinfo" string="Hours"/>
                    </button>
                </xpath>
            </field>
        </record>

        <!-- Employee tree view extension -->
        <record id="view_employee_tree_accountability" model="ir.ui.view">
            <field name="name">hr.employee.tree.accountability</field>
            <field name="model">hr.employee</field>
            <field name="inherit_id" ref="hr.view_employee_tree"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='name']" position="after">
                    <field name="employee_code"/>
                    <field name="parent_user_id"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
