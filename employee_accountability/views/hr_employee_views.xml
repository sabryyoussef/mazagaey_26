<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============================================= -->
    <!-- Employee Form View Extension -->
    <!-- ============================================= -->
    <record id="view_employee_form_accountability" model="ir.ui.view">
        <field name="name">hr.employee.form.accountability</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="priority">50</field>
        <field name="arch" type="xml">
            <!-- Add PIN Management buttons in header -->
            <xpath expr="//header" position="inside">
                <button name="action_set_pin" 
                        type="object" 
                        string="Set PIN" 
                        class="btn-secondary"
                        invisible="employee_pin"/>
                <button name="action_set_pin" 
                        type="object" 
                        string="Change PIN" 
                        class="btn-secondary"
                        invisible="not employee_pin"/>
                <button name="action_reset_pin" 
                        type="object" 
                        string="Reset PIN" 
                        class="btn-warning"
                        invisible="not employee_pin"
                        groups="hr.group_hr_manager"/>
            </xpath>
            
            <!-- Add Accountability tab -->
            <xpath expr="//notebook" position="inside">
                <page string="Accountability" name="accountability">
                    <group>
                        <group string="Shared User Configuration">
                            <field name="is_shared_user_employee" readonly="1"/>
                            <field name="shared_user_employee_ids" 
                                   widget="many2many_tags" 
                                   readonly="1"
                                   invisible="not is_shared_user_employee"/>
                        </group>
                        <group string="PIN Security">
                            <field name="pin_required"/>
                            <field name="pin_failed_attempts" readonly="1"/>
                            <field name="pin_locked_until" readonly="1"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <!-- ============================================= -->
    <!-- Employee Search View Extension -->
    <!-- ============================================= -->
    <record id="view_employee_search_accountability" model="ir.ui.view">
        <field name="name">hr.employee.search.accountability</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_filter"/>
        <field name="priority">50</field>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='my_team']" position="after">
                <separator/>
                <filter name="shared_user" 
                        string="Shared User Employees" 
                        domain="[('is_shared_user_employee', '=', True)]"/>
                <filter name="pin_locked" 
                        string="PIN Locked" 
                        domain="[('pin_locked_until', '!=', False)]"/>
            </xpath>
        </field>
    </record>
</odoo>
