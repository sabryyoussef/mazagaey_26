<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Extend project form view -->
        <record id="view_project_project_form_accountability" model="ir.ui.view">
            <field name="name">project.project.form.accountability</field>
            <field name="model">project.project</field>
            <field name="inherit_id" ref="project.edit_project"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='user_id']" position="after">
                    <field name="manager_employee_id"/>
                    <field name="portal_collaborator_ids" widget="many2many_tags"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
