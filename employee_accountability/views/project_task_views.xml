<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- Extend Project Task Form View -->
    <record id="view_task_form_employee_accountability" model="ir.ui.view">
        <field name="name">project.task.form.employee.accountability</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_form2"/>
        <field name="priority">20</field>
        <field name="arch" type="xml">
            <!-- Add Employee Assignment section after user_ids field -->
            <xpath expr="//field[@name='user_ids']" position="after">
                <label for="responsible_employee_id"/>
                <div class="o_row">
                    <field name="responsible_employee_id" 
                           options="{'no_create': True, 'no_quick_create': True}"/>
                    <button name="action_set_responsible_to_me" 
                            type="object" 
                            class="btn-link" 
                            string="Assign to me"
                            title="Set myself as responsible"/>
                </div>
            </xpath>
            
            <!-- Add Performed By field -->
            <xpath expr="//field[@name='user_ids']" position="after">
                <field name="performed_by_employee_id" 
                       options="{'no_create': True, 'no_quick_create': True}"
                       invisible="not id"/>
            </xpath>
            
            <!-- Add Participants in a new section -->
            <xpath expr="//page[@name='extra_info']" position="inside">
                <group string="Employee Accountability">
                    <group>
                        <field name="responsible_employee_id" 
                               options="{'no_create': True}"/>
                        <field name="responsible_employee_department_id" readonly="1"/>
                    </group>
                    <group>
                        <field name="performed_by_employee_id" 
                               options="{'no_create': True}"/>
                    </group>
                    <group colspan="2">
                        <field name="participant_employee_ids" 
                               widget="many2many_tags"
                               options="{'no_create': True}"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>

    <!-- Extend Project Task List View -->
    <record id="view_task_list_employee_accountability" model="ir.ui.view">
        <field name="name">project.task.list.employee.accountability</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_tree2"/>
        <field name="priority">20</field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='user_ids']" position="after">
                <field name="responsible_employee_id" optional="show"/>
                <field name="performed_by_employee_id" optional="hide"/>
            </xpath>
        </field>
    </record>

    <!-- Extend Project Task Kanban View -->
    <record id="view_task_kanban_employee_accountability" model="ir.ui.view">
        <field name="name">project.task.kanban.employee.accountability</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_kanban"/>
        <field name="priority">20</field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='user_ids']" position="after">
                <field name="responsible_employee_id"/>
            </xpath>
        </field>
    </record>

    <!-- Add Search Filters for Employee Fields -->
    <record id="view_task_search_employee_accountability" model="ir.ui.view">
        <field name="name">project.task.search.employee.accountability</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_search_form"/>
        <field name="priority">20</field>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='my_tasks']" position="after">
                <separator/>
                <filter string="My Responsible Tasks" 
                        name="my_responsible_tasks"
                        domain="[('responsible_employee_id.user_id', '=', uid)]"/>
                <filter string="My Performed Tasks" 
                        name="my_performed_tasks"
                        domain="[('performed_by_employee_id.user_id', '=', uid)]"/>
            </xpath>
            <xpath expr="//field[@name='user_ids']" position="after">
                <field name="responsible_employee_id"/>
                <field name="performed_by_employee_id"/>
            </xpath>
            <xpath expr="//group" position="inside">
                <filter string="Responsible Employee" 
                        name="group_by_responsible_employee"
                        context="{'group_by': 'responsible_employee_id'}"/>
                <filter string="Performed By" 
                        name="group_by_performed_by"
                        context="{'group_by': 'performed_by_employee_id'}"/>
                <filter string="Responsible Department" 
                        name="group_by_responsible_department"
                        context="{'group_by': 'responsible_employee_department_id'}"/>
            </xpath>
        </field>
    </record>

</odoo>
