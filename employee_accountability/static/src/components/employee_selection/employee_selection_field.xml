<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!-- Employee Selection Field Widget -->
    <t t-name="employee_accountability.EmployeeSelectionField">
        <div class="o_employee_selection_field position-relative">
            
            <!-- Selected Value Display / Trigger -->
            <div class="o_employee_selection_trigger d-flex align-items-center border rounded p-2 cursor-pointer"
                 t-att-class="{ 'border-primary': state.isOpen }"
                 t-on-click="onToggleDropdown">
                
                <t t-if="selectedEmployee">
                    <!-- Avatar -->
                    <div class="o_employee_avatar me-2">
                        <t t-if="selectedEmployee.avatar_128">
                            <img t-att-src="'data:image/png;base64,' + selectedEmployee.avatar_128" 
                                 class="rounded-circle"
                                 style="width: 24px; height: 24px;"/>
                        </t>
                        <t t-else="">
                            <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center"
                                 style="width: 24px; height: 24px; font-size: 10px;">
                                <t t-esc="selectedEmployee.name.charAt(0).toUpperCase()"/>
                            </div>
                        </t>
                    </div>
                    
                    <!-- Name and Job -->
                    <div class="flex-grow-1">
                        <span class="o_employee_name" t-esc="selectedEmployee.name"/>
                        <t t-if="selectedEmployee.job_title">
                            <small class="text-muted ms-1">(<t t-esc="selectedEmployee.job_title"/>)</small>
                        </t>
                    </div>
                    
                    <!-- Clear Button -->
                    <button class="btn btn-link btn-sm text-danger p-0 ms-2" 
                            t-on-click.stop="onClear"
                            title="Clear">
                        <i class="fa fa-times"/>
                    </button>
                </t>
                
                <t t-else="">
                    <span class="text-muted flex-grow-1" t-esc="props.placeholder"/>
                </t>
                
                <!-- Dropdown Arrow -->
                <i class="fa fa-caret-down ms-2 text-muted"/>
            </div>

            <!-- Dropdown Panel -->
            <div t-if="state.isOpen" 
                 class="o_employee_selection_dropdown position-absolute w-100 bg-white border rounded shadow-sm mt-1"
                 style="z-index: 1050; max-height: 350px; overflow: hidden;">
                
                <!-- Loading State -->
                <t t-if="state.isLoading">
                    <div class="p-3 text-center text-muted">
                        <i class="fa fa-spinner fa-spin me-1"/>
                        Loading...
                    </div>
                </t>
                
                <t t-else="">
                    <!-- Filters Section -->
                    <div class="o_employee_filters p-2 border-bottom bg-light">
                        <!-- Search Input -->
                        <div class="mb-2">
                            <input type="text" 
                                   class="form-control form-control-sm"
                                   placeholder="Search employees..."
                                   t-att-value="state.searchQuery"
                                   t-on-input="onSearchInput"/>
                        </div>
                        
                        <!-- Department Filter -->
                        <t t-if="props.showDepartmentFilter and state.departments.length > 0">
                            <select class="form-select form-select-sm"
                                    t-on-change="onDepartmentChange">
                                <option value="">All Departments</option>
                                <t t-foreach="state.departments" t-as="dept" t-key="dept.id">
                                    <option t-att-value="dept.id" 
                                            t-att-selected="state.selectedDepartmentId === dept.id">
                                        <t t-esc="dept.name"/>
                                    </option>
                                </t>
                            </select>
                        </t>
                    </div>
                    
                    <!-- Employee List -->
                    <div class="o_employee_list" style="max-height: 250px; overflow-y: auto;">
                        <t t-if="filteredEmployees.length === 0">
                            <div class="p-3 text-center text-muted">
                                <i class="fa fa-users me-1"/>
                                No employees found
                            </div>
                        </t>
                        
                        <t t-foreach="filteredEmployees" t-as="employee" t-key="employee.id">
                            <div class="o_employee_item d-flex align-items-center p-2 cursor-pointer"
                                 t-att-class="{ 'bg-primary-subtle': selectedEmployee and selectedEmployee.id === employee.id }"
                                 t-on-click="() => this.onSelectEmployee(employee)">
                                
                                <!-- Avatar -->
                                <div class="o_employee_avatar me-2">
                                    <t t-if="employee.avatar_128">
                                        <img t-att-src="'data:image/png;base64,' + employee.avatar_128" 
                                             class="rounded-circle"
                                             style="width: 32px; height: 32px;"/>
                                    </t>
                                    <t t-else="">
                                        <div class="rounded-circle bg-secondary text-white d-flex align-items-center justify-content-center"
                                             style="width: 32px; height: 32px; font-size: 12px;">
                                            <t t-esc="employee.name.charAt(0).toUpperCase()"/>
                                        </div>
                                    </t>
                                </div>
                                
                                <!-- Info -->
                                <div class="flex-grow-1">
                                    <div class="o_employee_name fw-medium" t-esc="employee.name"/>
                                    <t t-if="employee.job_title or employee.department_id">
                                        <small class="text-muted">
                                            <t t-if="employee.job_title" t-esc="employee.job_title"/>
                                            <t t-if="employee.job_title and employee.department_id"> · </t>
                                            <t t-if="employee.department_id" t-esc="employee.department_id[1]"/>
                                        </small>
                                    </t>
                                </div>
                                
                                <!-- Selected Indicator -->
                                <t t-if="selectedEmployee and selectedEmployee.id === employee.id">
                                    <i class="fa fa-check text-success"/>
                                </t>
                            </div>
                        </t>
                    </div>
                </t>
            </div>
            
            <!-- Click Outside Handler (invisible overlay) -->
            <div t-if="state.isOpen" 
                 class="position-fixed top-0 start-0 w-100 h-100"
                 style="z-index: 1049;"
                 t-on-click="onToggleDropdown"/>
        </div>
    </t>

</templates>
