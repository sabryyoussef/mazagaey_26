        <!-- ============================================== -->
        <!-- DEPARTMENT SHARED USERS                        -->
        <!-- ============================================== -->

        <!-- Operations Department Shared User (for regular employees) -->
        <record id="user_dept_ops" model="res.users">
            <field name="name">Operations Department User</field>
            <field name="login">user.dept.ops</field>
            <field name="password">user.dept.ops</field>
            <field name="groups_id" eval="[(4, ref('base.group_user')), (4, ref('hr.group_hr_user'))]"/>
            <field name="active">True</field>
        </record>

        <!-- Operations Department Admin User (for manager) -->
        <record id="admin_dept_ops" model="res.users">
            <field name="name">Operations Admin User</field>
            <field name="login">admin.dept.ops</field>
            <field name="password">admin.dept.ops</field>
            <field name="groups_id" eval="[(4, ref('base.group_user')), (4, ref('hr.group_hr_manager'))]"/>
            <field name="active">True</field>
        </record>

