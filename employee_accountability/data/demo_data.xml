<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- ============================================== -->
        <!-- PARENT SHARED USER                             -->
        <!-- This is the single Odoo user license shared   -->
        <!-- by multiple employees in Operations           -->
        <!-- ============================================== -->

        <!-- Operations Department Shared User (Parent User) -->
        <record id="user_dept_ops" model="res.users">
            <field name="name">Operations Department User</field>
            <field name="login">user.dept.ops</field>
            <field name="password">user.dept.ops</field>
            <field name="groups_id" eval="[(4, ref('base.group_user')), (4, ref('hr.group_hr_user')), (4, ref('project.group_project_user'))]"/>
            <field name="active">True</field>
        </record>

        <!-- ============================================== -->
        <!-- EMPLOYEES USING EMPLOYEE CODE SYSTEM          -->
        <!-- ============================================== -->
        
        <!--
            Employee Code System:
            Each employee gets a unique code generated via the 
            "Generate Employee Code" button on their employee form.
            
            For demo purposes, we create employees linked to the 
            parent shared user. Codes will be generated manually
            or via a script after installation.
            
            Parent User: user.dept.ops
            Child Employees:
            - Ahmed Ali (Senior Specialist)
            - Fatima Hassan (Junior Specialist)
            - Omar Said (Senior Specialist)
            - Layla Mohamed (Junior Specialist)
        -->

        <!-- Employee 1: Ahmed Ali (Operations - Senior) -->
        <record id="employee_ahmed_ali" model="hr.employee">
            <field name="name">Ahmed Ali</field>
            <field name="parent_user_id" ref="user_dept_ops"/>
            <field name="job_title">Operations Senior Specialist</field>
            <field name="work_email">ahmed.ali@example.com</field>
            <field name="code_active">False</field>
        </record>

        <!-- Employee 2: Fatima Hassan (Operations - Junior) -->
        <record id="employee_fatima_hassan" model="hr.employee">
            <field name="name">Fatima Hassan</field>
            <field name="parent_user_id" ref="user_dept_ops"/>
            <field name="job_title">Operations Junior Specialist</field>
            <field name="work_email">fatima.hassan@example.com</field>
            <field name="code_active">False</field>
        </record>

        <!-- Employee 3: Omar Said (Operations - Senior) -->
        <record id="employee_omar_said" model="hr.employee">
            <field name="name">Omar Said</field>
            <field name="parent_user_id" ref="user_dept_ops"/>
            <field name="job_title">Operations Senior Specialist</field>
            <field name="work_email">omar.said@example.com</field>
            <field name="code_active">False</field>
        </record>

        <!-- Employee 4: Layla Mohamed (Operations - Junior) -->
        <record id="employee_layla_mohamed" model="hr.employee">
            <field name="name">Layla Mohamed</field>
            <field name="parent_user_id" ref="user_dept_ops"/>
            <field name="job_title">Operations Junior Specialist</field>
            <field name="work_email">layla.mohamed@example.com</field>
            <field name="code_active">False</field>
        </record>

    </data>
</odoo>
