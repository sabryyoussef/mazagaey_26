<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Cron job to end old active sessions (daily) -->
        <record id="ir_cron_end_old_sessions" model="ir.cron">
            <field name="name">End Old Employee Sessions</field>
            <field name="model_id" ref="model_employee_session_context"/>
            <field name="state">code</field>
            <field name="code">model._end_old_sessions()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
