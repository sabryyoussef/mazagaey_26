<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============================================= -->
    <!-- Employee Selection Wizard View -->
    <!-- ============================================= -->
    <record id="view_employee_select_wizard_form" model="ir.ui.view">
        <field name="name">employee.select.wizard.form</field>
        <field name="model">employee.select.wizard</field>
        <field name="arch" type="xml">
            <form string="Select Employee">
                <group>
                    <group>
                        <field name="user_id" invisible="1"/>
                        <field name="employee_ids" invisible="1"/>
                        <field name="employee_id" 
                               options="{'no_create': True, 'no_open': True}"
                               widget="selection"/>
                    </group>
                </group>
                <group invisible="not pin_required">
                    <group>
                        <field name="pin_required" invisible="1"/>
                        <label for="pin"/>
                        <div class="o_row">
                            <field name="pin" 
                                   password="True" 
                                   placeholder="Enter your PIN"
                                   invisible="show_pin"/>
                            <field name="pin" 
                                   placeholder="Enter your PIN"
                                   invisible="not show_pin"/>
                            <field name="show_pin" widget="boolean_toggle" nolabel="1"/>
                            <span class="text-muted ms-2">Show PIN</span>
                        </div>
                    </group>
                </group>
                <footer>
                    <button name="action_confirm" 
                            type="object" 
                            string="Confirm" 
                            class="btn-primary"/>
                    <button name="action_cancel" 
                            type="object" 
                            string="Cancel" 
                            class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- ============================================= -->
    <!-- Employee PIN Setup Wizard View -->
    <!-- ============================================= -->
    <record id="view_employee_pin_wizard_form" model="ir.ui.view">
        <field name="name">employee.pin.wizard.form</field>
        <field name="model">employee.pin.wizard</field>
        <field name="arch" type="xml">
            <form string="Set Employee PIN">
                <group>
                    <field name="employee_id" readonly="1"/>
                    <field name="has_existing_pin" invisible="1"/>
                </group>
                <group invisible="not has_existing_pin">
                    <field name="current_pin" 
                           password="True" 
                           placeholder="Enter current PIN"
                           required="has_existing_pin"/>
                </group>
                <group>
                    <field name="new_pin" 
                           password="True" 
                           placeholder="Enter 4-8 digit PIN"/>
                    <field name="confirm_pin" 
                           password="True" 
                           placeholder="Confirm PIN"/>
                </group>
                <group>
                    <div class="alert alert-info" role="alert">
                        <strong>PIN Requirements:</strong>
                        <ul class="mb-0">
                            <li>Must be 4-8 digits</li>
                            <li>Numbers only</li>
                            <li>Keep it secret!</li>
                        </ul>
                    </div>
                </group>
                <footer>
                    <button name="action_set_pin" 
                            type="object" 
                            string="Set PIN" 
                            class="btn-primary"/>
                    <button name="action_cancel" 
                            type="object" 
                            string="Cancel" 
                            class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- ============================================= -->
    <!-- Wizard Actions -->
    <!-- ============================================= -->
    <record id="action_employee_select_wizard" model="ir.actions.act_window">
        <field name="name">Select Employee</field>
        <field name="res_model">employee.select.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
