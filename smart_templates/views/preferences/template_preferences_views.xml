<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_smart_template_preferences_form" model="ir.ui.view">
        <field name="name">smart.template.preferences.form</field>
        <field name="model">smart.template.preferences</field>
        <field name="arch" type="xml">
            <form string="Template Preferences">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Preference Name"/></h1>
                    </div>
                    <group>
                        <field name="description"/>
                        <field name="is_active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
