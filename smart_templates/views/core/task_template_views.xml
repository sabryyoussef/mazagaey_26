<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Task Template Form View -->
    <record id="view_smart_task_template_form" model="ir.ui.view">
        <field name="name">smart.task.template.form</field>
        <field name="model">smart.task.template</field>
        <field name="arch" type="xml">
            <form string="Task Template">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Task Template Name"/>
                        </h1>
                    </div>
                    
                    <group>
                        <group string="Basic Information">
                            <field name="task_type"/>
                            <field name="priority"/>
                            <field name="complexity_level"/>
                            <field name="workflow_stage"/>
                            <field name="is_active"/>
                        </group>
                        <group string="Time Estimation">
                            <field name="estimated_hours"/>
                            <field name="estimated_days"/>
                        </group>
                    </group>
                    
                    <group>
                        <group string="Smart Features">
                            <field name="suggestion_level"/>
                            <field name="auto_assign"/>
                            <field name="auto_schedule"/>
                        </group>
                        <group string="Usage Statistics">
                            <field name="usage_count" readonly="1"/>
                            <field name="total_projects" readonly="1"/>
                            <field name="last_used" readonly="1"/>
                        </group>
                    </group>
                    
                    <group>
                        <field name="description"/>
                    </group>
                    
                    <group>
                        <field name="required_skills"/>
                    </group>
                    
                    <group>
                        <field name="prerequisites"/>
                    </group>
                    
                    <group>
                        <field name="deliverables"/>
                    </group>
                    
                    <notebook>
                        <page string="Related Projects" name="related_projects">
                            <field name="project_template_ids" nolabel="1">
                                <list>
                                    <field name="name"/>
                                    <field name="template_type"/>
                                    <field name="complexity_level"/>
                                    <field name="is_active"/>
                                </list>
                            </field>
                        </page>
                        
                        <page string="Statistics" name="statistics">
                            <group>
                                <field name="usage_count" readonly="1"/>
                                <field name="total_projects" readonly="1"/>
                                <field name="last_used" readonly="1"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    
    <!-- Task Template List View -->
    <record id="view_smart_task_template_list" model="ir.ui.view">
        <field name="name">smart.task.template.list</field>
        <field name="model">smart.task.template</field>
        <field name="arch" type="xml">
            <list string="Task Templates">
                <field name="name"/>
                <field name="task_type"/>
                <field name="priority"/>
                <field name="complexity_level"/>
                <field name="estimated_hours"/>
                <field name="estimated_days"/>
                <field name="total_projects"/>
                <field name="usage_count"/>
                <field name="is_active"/>
            </list>
        </field>
    </record>
    
    <!-- Task Template Search View -->
    <record id="view_smart_task_template_search" model="ir.ui.view">
        <field name="name">smart.task.template.search</field>
        <field name="model">smart.task.template</field>
        <field name="arch" type="xml">
            <search string="Task Templates">
                <field name="name"/>
                <field name="description"/>
                <field name="task_type"/>
                <field name="complexity_level"/>
                <field name="required_skills"/>
                
                <filter string="Active Templates" name="active" 
                        domain="[('is_active', '=', True)]"/>
                <filter string="Development Tasks" name="development" 
                        domain="[('task_type', '=', 'development')]"/>
                <filter string="Testing Tasks" name="testing" 
                        domain="[('task_type', '=', 'testing')]"/>
                <filter string="Documentation Tasks" name="documentation" 
                        domain="[('task_type', '=', 'documentation')]"/>
                <filter string="Review Tasks" name="review" 
                        domain="[('task_type', '=', 'review')]"/>
                <filter string="Deployment Tasks" name="deployment" 
                        domain="[('task_type', '=', 'deployment')]"/>
                <filter string="Maintenance Tasks" name="maintenance" 
                        domain="[('task_type', '=', 'maintenance')]"/>
                <filter string="Analysis Tasks" name="analysis" 
                        domain="[('task_type', '=', 'analysis')]"/>
                <filter string="Design Tasks" name="design" 
                        domain="[('task_type', '=', 'design')]"/>
                <filter string="Other Tasks" name="other" 
                        domain="[('task_type', '=', 'other')]"/>
                
                <separator/>
                <filter string="High Priority" name="high_priority" 
                        domain="[('priority', 'in', ['2', '3'])]"/>
                <filter string="Complex Tasks" name="complex" 
                        domain="[('complexity_level', '=', 'complex')]"/>
                <filter string="Frequently Used" name="frequently_used" 
                        domain="[('usage_count', '>', 5)]"/>
                
                <group expand="0" string="Group By">
                    <filter string="Task Type" name="group_task_type" 
                            context="{'group_by': 'task_type'}"/>
                    <filter string="Priority" name="group_priority" 
                            context="{'group_by': 'priority'}"/>
                    <filter string="Complexity Level" name="group_complexity" 
                            context="{'group_by': 'complexity_level'}"/>
                    <filter string="Workflow Stage" name="group_workflow" 
                            context="{'group_by': 'workflow_stage'}"/>
                </group>
            </search>
        </field>
    </record>
    
    <!-- Task Template Actions -->
    <record id="action_smart_task_template" model="ir.actions.act_window">
        <field name="name">Task Templates</field>
        <field name="res_model">smart.task.template</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_smart_task_template_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first Task Template!
            </p>
            <p>
                Task templates help you standardize and accelerate task creation.
                Define templates with specific task types, priorities, and requirements.
            </p>
        </field>
    </record>
</odoo>
